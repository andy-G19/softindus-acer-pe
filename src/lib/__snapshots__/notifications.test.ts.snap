exports[`toasts > escapa el HTML del mensaje y de la descripcion 1`] = `
[
  {
    "html": "<div class="space-y-1"><p class="text-sm font-semibold">Error &lt;b&gt;grave&lt;/b&gt; &amp; total</p><p class="text-xs leading-relaxed text-muted-foreground">&lt;img src=x onerror=alert(1)&gt;</p></div>",
