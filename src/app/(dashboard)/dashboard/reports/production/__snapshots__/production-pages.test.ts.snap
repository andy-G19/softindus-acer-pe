exports[`/dashboard/reports/production > maestro de taller > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "orderBy": {
        "nombre_producto": "asc",
      },
      "where": {
        "estado": true,
      },
    },
    "prisma": "producto.findMany",
  },
  {
    "args": {
      "include": {
        "avance_orden": {
          "select": {
            "estado_etapa": true,
            "porcentaje_avance": true,
          },
        },
        "cliente": true,
        "producto": true,
        "ruta_fabricacion": true,
      },
      "orderBy": [
        {
          "fecha_inicio": "desc",
        },
        {
          "fecha_registro": "desc",
        },
      ],
      "take": 100,
      "where": {},
    },
    "prisma": "orden_trabajo.findMany",
  },
]
`;

