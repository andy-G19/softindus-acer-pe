exports[`/dashboard/reports/production > todos los filtros > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "orderBy": {
        "nombre_producto": "asc",
      },
      "where": {
        "estado": true,
      },
    },
    "prisma": "producto.findMany",
  },
  {
    "args": {
      "include": {
        "avance_orden": {
          "select": {
            "estado_etapa": true,
            "porcentaje_avance": true,
          },
        },
        "cliente": true,
        "producto": true,
        "ruta_fabricacion": true,
      },
      "orderBy": [
        {
          "fecha_inicio": "desc",
        },
        {
          "fecha_registro": "desc",
        },
      ],
      "take": 100,
      "where": {
        "estado": "en_proceso",
        "fecha_inicio": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-08-01T00:00:00.000Z,
        },
        "id_orden_trabajo": {
          "contains": "OTR0000",
        },
        "id_producto": "PRO00000001",
      },
    },
    "prisma": "orden_trabajo.findMany",
  },
]
`;

