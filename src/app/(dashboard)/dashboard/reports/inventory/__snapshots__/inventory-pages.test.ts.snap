exports[`/dashboard/reports/inventory > todos los filtros > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "orderBy": {
        "nombre_material": "asc",
      },
      "where": {
        "estado": true,
      },
    },
    "prisma": "material.findMany",
  },
  {
    "args": {
      "orderBy": [
        {
          "apellidos": "asc",
        },
        {
          "nombres": "asc",
        },
      ],
      "where": {
        "estado": "activo",
      },
    },
    "prisma": "usuario.findMany",
  },
  {
    "args": {
      "include": {
        "compra": {
          "include": {
            "proveedor": true,
          },
        },
        "material": true,
        "orden_trabajo": {
          "include": {
            "producto": true,
          },
        },
        "usuario": true,
      },
      "orderBy": {
        "fecha_movimiento": "desc",
      },
      "take": 100,
      "where": {
        "fecha_movimiento": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-07-16T00:00:00.000Z,
        },
        "id_material": "MAT00000001",
        "id_orden_trabajo": {
          "contains": "OTR00000001",
        },
        "id_usuario_responsable": "USU00000002",
        "tipo_movimiento": "salida",
      },
    },
    "prisma": "movimiento_inventario.findMany",
  },
]
`;

