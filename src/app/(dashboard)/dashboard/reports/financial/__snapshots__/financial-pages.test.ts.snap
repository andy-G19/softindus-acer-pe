exports[`/dashboard/reports/financial > todos los filtros > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "orderBy": {
        "nombre_caja": "asc",
      },
    },
    "prisma": "caja_chica.findMany",
  },
  {
    "args": {
      "orderBy": {
        "nombre_categoria": "asc",
      },
      "where": {
        "estado": true,
      },
    },
    "prisma": "categoria_gasto.findMany",
  },
  {
    "args": {
      "include": {
        "caja_chica": true,
        "categoria_gasto": true,
        "usuario": true,
      },
      "orderBy": {
        "fecha_movimiento": "desc",
      },
      "take": 100,
      "where": {
        "OR": [
          {
            "concepto": {
              "contains": "Combustible",
              "mode": "insensitive",
            },
          },
          {
            "responsable": {
              "contains": "Combustible",
              "mode": "insensitive",
            },
          },
          {
            "comprobante": {
              "contains": "Combustible",
              "mode": "insensitive",
            },
          },
        ],
        "fecha_movimiento": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-08-01T00:00:00.000Z,
        },
        "id_caja_chica": "CCH00000001",
        "id_categoria_gasto": "CGA00000001",
        "tipo_movimiento": "egreso",
      },
    },
    "prisma": "movimiento_caja.findMany",
  },
  {
    "args": {
      "_sum": {
        "saldo_actual": true,
      },
      "where": {
        "estado": "abierta",
      },
    },
    "prisma": "caja_chica.aggregate",
  },
  {
    "args": {
      "_sum": {
        "monto_pagado": true,
      },
      "where": {
        "fecha_pago": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-08-01T00:00:00.000Z,
        },
      },
    },
    "prisma": "pago_cliente.aggregate",
  },
  {
    "args": {
      "_sum": {
        "costo_consumibles": true,
        "costo_indirecto_total": true,
        "costo_mano_obra": true,
        "costo_materiales": true,
        "costo_total": true,
      },
      "where": {
        "fecha_costeo": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-08-01T00:00:00.000Z,
        },
      },
    },
    "prisma": "costeo.aggregate",
  },
  {
    "args": {
      "_sum": {
        "costo_total": true,
        "ingreso_estimado": true,
        "utilidad_estimada": true,
      },
      "where": {
        "fecha_calculo": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-08-01T00:00:00.000Z,
        },
      },
    },
    "prisma": "rentabilidad.aggregate",
  },
  {
    "args": {
      "where": {
        "alerta_bajo_margen": true,
        "fecha_calculo": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-08-01T00:00:00.000Z,
        },
      },
    },
    "prisma": "rentabilidad.count",
  },
  {
    "args": {
      "_sum": {
        "saldo": true,
      },
      "where": {
        "estado": {
          "in": [
            "vigente",
            "aceptada",
          ],
        },
        "fecha_emision": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-08-01T00:00:00.000Z,
        },
        "saldo": {
          "gt": 0,
        },
      },
    },
    "prisma": "proforma.aggregate",
  },
  {
    "args": {
      "include": {
        "pago_proveedor": true,
        "proveedor": true,
      },
      "orderBy": {
        "fecha_compra": "desc",
      },
      "take": 100,
      "where": {
        "estado_compra": {
          "not": "anulada",
        },
        "estado_pago": {
          "in": [
            "pendiente",
            "parcial",
          ],
        },
        "fecha_compra": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-08-01T00:00:00.000Z,
        },
      },
    },
    "prisma": "compra.findMany",
  },
]
`;

