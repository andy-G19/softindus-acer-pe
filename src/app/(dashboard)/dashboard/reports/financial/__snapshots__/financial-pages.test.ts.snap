exports[`/dashboard/reports/financial > sin filtros > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "orderBy": {
        "nombre_caja": "asc",
      },
    },
    "prisma": "caja_chica.findMany",
  },
  {
    "args": {
      "orderBy": {
        "nombre_categoria": "asc",
      },
      "where": {
        "estado": true,
      },
    },
    "prisma": "categoria_gasto.findMany",
  },
  {
    "args": {
      "include": {
        "caja_chica": true,
        "categoria_gasto": true,
        "usuario": true,
      },
      "orderBy": {
        "fecha_movimiento": "desc",
      },
      "take": 100,
      "where": {},
    },
    "prisma": "movimiento_caja.findMany",
  },
  {
    "args": {
      "_sum": {
        "saldo_actual": true,
      },
      "where": {
        "estado": "abierta",
      },
    },
    "prisma": "caja_chica.aggregate",
  },
  {
    "args": {
      "_sum": {
        "monto_pagado": true,
      },
      "where": {},
    },
    "prisma": "pago_cliente.aggregate",
  },
  {
    "args": {
      "_sum": {
        "costo_consumibles": true,
        "costo_indirecto_total": true,
        "costo_mano_obra": true,
        "costo_materiales": true,
        "costo_total": true,
      },
      "where": {},
    },
    "prisma": "costeo.aggregate",
  },
  {
    "args": {
      "_sum": {
        "costo_total": true,
        "ingreso_estimado": true,
        "utilidad_estimada": true,
      },
      "where": {},
    },
    "prisma": "rentabilidad.aggregate",
  },
  {
    "args": {
      "where": {
        "alerta_bajo_margen": true,
      },
    },
    "prisma": "rentabilidad.count",
  },
  {
    "args": {
      "_sum": {
        "saldo": true,
      },
      "where": {
        "estado": {
          "in": [
            "vigente",
            "aceptada",
          ],
        },
        "saldo": {
          "gt": 0,
        },
      },
    },
    "prisma": "proforma.aggregate",
  },
  {
    "args": {
      "include": {
        "pago_proveedor": true,
        "proveedor": true,
      },
      "orderBy": {
        "fecha_compra": "desc",
      },
      "take": 100,
      "where": {
        "estado_compra": {
          "not": "anulada",
        },
        "estado_pago": {
          "in": [
            "pendiente",
            "parcial",
          ],
        },
      },
    },
    "prisma": "compra.findMany",
  },
]
`;

