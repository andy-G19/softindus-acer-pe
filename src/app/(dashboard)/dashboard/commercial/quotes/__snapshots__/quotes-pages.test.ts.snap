exports[`/dashboard/commercial/quotes > saldo pagado > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "SELLER",
    ],
  },
  {
    "args": {
      "include": {
        "comprobante_venta": {
          "select": {
            "id_comprobante": true,
            "numero_comprobante": true,
            "tipo_comprobante": true,
          },
          "where": {
            "estado": "emitido",
          },
        },
        "pago_cliente": {
          "select": {
            "id_pago_cliente": true,
          },
        },
        "pedido": {
          "include": {
            "cliente": true,
            "detalle_pedido": {
              "include": {
                "producto": true,
              },
            },
          },
        },
      },
      "orderBy": {
        "fecha_emision": "desc",
      },
      "where": {
        "AND": [
          {
            "saldo": 0,
          },
        ],
      },
    },
    "prisma": "proforma.findMany",
  },
  {
    "args": {
      "orderBy": {
        "nombre_razon_social": "asc",
      },
      "select": {
        "id_cliente": true,
        "nombre_razon_social": true,
      },
    },
    "prisma": "cliente.findMany",
  },
  {
    "args": {
      "orderBy": {
        "fecha_pedido": "desc",
      },
      "select": {
        "id_pedido": true,
      },
    },
    "prisma": "pedido.findMany",
  },
]
`;

