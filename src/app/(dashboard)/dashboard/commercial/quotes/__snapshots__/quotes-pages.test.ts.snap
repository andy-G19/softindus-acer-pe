        },
        "estado": {
          "in": [
            "registrado",
            "aprobado",
          ],
        },
        "proforma": {
          "none": {
            "estado": {
              "in": [
                "vigente",
                "aceptada",
                "pagada",
              ],
            },
          },
        },
      },
    },
    "prisma": "pedido.findMany",
  },
]
`;

