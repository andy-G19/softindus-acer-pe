exports[`/dashboard/commercial/quotes > todos los filtros con saldo pendiente > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "SELLER",
    ],
  },
  {
    "args": {
      "include": {
        "comprobante_venta": {
          "select": {
            "id_comprobante": true,
            "numero_comprobante": true,
            "tipo_comprobante": true,
          },
          "where": {
            "estado": "emitido",
          },
        },
        "pago_cliente": {
          "select": {
            "id_pago_cliente": true,
          },
        },
        "pedido": {
          "include": {
            "cliente": true,
            "detalle_pedido": {
              "include": {
                "producto": true,
              },
            },
          },
        },
      },
      "orderBy": {
        "fecha_emision": "desc",
      },
      "where": {
        "AND": [
          {
            "OR": [
              {
                "numero_proforma": {
                  "contains": "PRF",
                  "mode": "insensitive",
                },
              },
              {
                "id_pedido": {
                  "contains": "PRF",
                  "mode": "insensitive",
                },
              },
              {
                "pedido": {
                  "cliente": {
                    "nombre_razon_social": {
                      "contains": "PRF",
                      "mode": "insensitive",
                    },
                  },
                },
              },
            ],
          },
          {
            "pedido": {
              "id_cliente": "CLI00000001",
            },
          },
          {
            "id_pedido": "PED00000001",
          },
          {
            "estado": "vigente",
          },
          {
            "saldo": {
              "gt": 0,
            },
          },
          {
            "fecha_emision": {
              "gte": 2026-07-01T00:00:00.000Z,
              "lte": 2026-07-31T23:59:59.999Z,
            },
          },
        ],
      },
    },
    "prisma": "proforma.findMany",
  },
  {
    "args": {
      "orderBy": {
        "nombre_razon_social": "asc",
      },
      "select": {
        "id_cliente": true,
        "nombre_razon_social": true,
      },
    },
    "prisma": "cliente.findMany",
  },
  {
    "args": {
      "orderBy": {
        "fecha_pedido": "desc",
      },
      "select": {
        "id_pedido": true,
      },
    },
    "prisma": "pedido.findMany",
  },
]
`;

