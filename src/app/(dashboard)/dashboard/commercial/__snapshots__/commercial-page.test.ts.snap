exports[`/dashboard/commercial > indicadores > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "SELLER",
    ],
  },
  {
    "args": {
      "where": {
        "estado": true,
      },
    },
    "prisma": "cliente.count",
  },
  {
    "args": {
      "where": {
        "estado": true,
      },
    },
    "prisma": "producto.count",
  },
  {
    "args": undefined,
    "prisma": "pedido.count",
  },
  {
    "args": {
      "where": {
        "estado": {
          "in": [
            "vigente",
            "aceptada",
          ],
        },
      },
    },
    "prisma": "proforma.count",
  },
  {
    "args": {
      "where": {
        "estado": "emitido",
      },
    },
    "prisma": "comprobante_venta.count",
  },
  {
    "args": {
      "select": {
        "saldo": true,
      },
      "where": {
        "estado": {
          "in": [
            "vigente",
            "aceptada",
          ],
        },
      },
    },
    "prisma": "proforma.findMany",
  },
]
`;

