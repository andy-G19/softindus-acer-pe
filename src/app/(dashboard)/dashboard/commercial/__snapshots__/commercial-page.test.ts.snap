        "estado": "emitido",
      },
    },
    "prisma": "comprobante_venta.count",
  },
  {
    "args": {
      "select": {
        "saldo": true,
      },
      "where": {
        "estado": {
          "in": [
            "vigente",
            "aceptada",
          ],
        },
      },
    },
    "prisma": "proforma.findMany",
  },
]
`;

