exports[`/dashboard/petty-cash/expenses/new > formulario > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "orderBy": {
        "nombre_caja": "asc",
      },
      "where": {
        "estado": "abierta",
      },
    },
    "prisma": "caja_chica.findMany",
  },
  {
    "args": {
      "orderBy": {
        "nombre_categoria": "asc",
      },
      "where": {
        "estado": true,
      },
    },
    "prisma": "categoria_gasto.findMany",
  },
  {
    "args": {
      "include": {
        "caja_chica": true,
        "categoria_gasto": true,
      },
      "orderBy": {
        "fecha_movimiento": "desc",
      },
      "take": 5,
      "where": {
        "tipo_movimiento": "egreso",
      },
    },
    "prisma": "movimiento_caja.findMany",
  },
]
`;

