exports[`/dashboard/petty-cash/boxes > listado > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "include": {
        "_count": {
          "select": {
            "movimiento_caja": true,
          },
        },
      },
      "orderBy": [
        {
          "estado": "asc",
        },
        {
          "fecha_apertura": "desc",
        },
      ],
    },
    "prisma": "caja_chica.findMany",
  },
]
`;

