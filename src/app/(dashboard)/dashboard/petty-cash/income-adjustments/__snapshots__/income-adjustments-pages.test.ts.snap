// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`/dashboard/petty-cash/income-adjustments/new > formulario > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "orderBy": {
        "nombre_caja": "asc",
      },
      "select": {
        "id_caja_chica": true,
        "nombre_caja": true,
        "saldo_actual": true,
      },
      "where": {
        "estado": "abierta",
      },
    },
    "prisma": "caja_chica.findMany",
  },
  {
    "args": {
      "include": {
        "caja_chica": true,
      },
      "orderBy": {
        "fecha_movimiento": "desc",
      },
      "take": 6,
      "where": {
        "tipo_movimiento": {
          "in": [
            "ingreso",
            "ajuste",
          ],
        },
      },
    },
    "prisma": "movimiento_caja.findMany",
  },
]
`;

