[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "include": {
        "costo_indirecto": {
          "orderBy": {
            "fecha_registro": "desc",
          },
        },
        "margen_ganancia": {
          "orderBy": {
            "fecha_aplicacion": "desc",
          },
        },
        "orden_trabajo": {
          "include": {
            "cliente": true,
            "detalle_pedido": {
              "include": {
                "pedido": {
                  "include": {
                    "cliente": true,
                  },
                },
              },
            },
            "producto": true,
            "version_receta": {
              "include": {
                "detalle_receta": {
                  "include": {
                    "material": true,
                  },
                  "orderBy": {
                    "id_detalle_receta": "asc",
                  },
                },
                "receta_tecnica": true,
              },
            },
          },
        },
        "pedido": {
          "include": {
            "cliente": true,
          },
        },
        "rentabilidad": {
          "orderBy": {
            "fecha_calculo": "desc",
          },
        },
        "usuario": {
          "select": {
            "apellidos": true,
            "nombres": true,
          },
        },
      },
      "where": {
        "id_costeo": "COS99999999",
      },
    },
    "prisma": "costeo.findUnique",
  },
]
`;

