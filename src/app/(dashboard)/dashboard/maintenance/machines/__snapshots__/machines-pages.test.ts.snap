<div>
<div>
<div>Datos principales</div>
</div>
<div>
<form action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)">
<input type="hidden" name="id_maquina" value="id_maquina-1"/>
<div>
<div>
<label for="nombre">Nombre de la maquina</label>
<input id="nombre" required="" name="nombre" value="nombre-1"/>
</div>
<div>
<label for="tipo">Tipo de maquina</label>
<select id="tipo" name="tipo" required="">
<option value="prensa">prensa</option>
<option value="cortadora">cortadora</option>
<option value="soldadora">soldadora</option>
<option value="esmeril">esmeril</option>
