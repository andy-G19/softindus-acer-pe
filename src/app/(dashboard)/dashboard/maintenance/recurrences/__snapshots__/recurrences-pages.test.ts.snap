// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`/dashboard/maintenance/recurrences > reporte del mes > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "include": {
        "falla_maquina": {
          "include": {
            "reparacion": true,
          },
        },
        "mantenimiento_preventivo": true,
      },
      "orderBy": {
        "nombre": "asc",
      },
    },
    "prisma": "maquina.findMany",
  },
  {
    "args": {
      "where": {
        "fecha_falla": {
          "gte": 2026-07-01T00:00:00.000Z,
        },
      },
    },
    "prisma": "falla_maquina.count",
  },
  {
    "args": {
      "_sum": {
        "costo_total": true,
      },
      "where": {
        "fecha_reparacion": {
          "gte": 2026-07-01T00:00:00.000Z,
        },
      },
    },
    "prisma": "reparacion.aggregate",
  },
  {
    "args": {
      "where": {
        "estado": "pendiente",
        "fecha_programada": {
          "lt": 2026-07-15T00:00:00.000Z,
        },
      },
    },
    "prisma": "mantenimiento_preventivo.count",
  },
  {
    "args": {
      "where": {
        "estado_atencion": {
          "in": [
            "pendiente",
            "en_atencion",
          ],
        },
      },
    },
    "prisma": "falla_maquina.count",
  },
]
`;

