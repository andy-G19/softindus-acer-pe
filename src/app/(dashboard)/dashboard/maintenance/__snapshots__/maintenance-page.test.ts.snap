// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`/dashboard/maintenance > indicadores del mes > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": undefined,
    "prisma": "maquina.count",
  },
  {
    "args": {
      "where": {
        "estado": "operativa",
      },
    },
    "prisma": "maquina.count",
  },
  {
    "args": {
      "where": {
        "estado_atencion": {
          "in": [
            "pendiente",
            "en_atencion",
          ],
        },
      },
    },
    "prisma": "falla_maquina.count",
  },
  {
    "args": {
      "where": {
        "fecha_falla": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-08-01T00:00:00.000Z,
        },
      },
    },
    "prisma": "falla_maquina.count",
  },
  {
    "args": {
      "where": {
        "estado": "pendiente",
      },
    },
    "prisma": "mantenimiento_preventivo.count",
  },
  {
    "args": {
      "where": {
        "estado": "pendiente",
        "fecha_programada": {
          "lt": 2026-07-15T00:00:00.000Z,
        },
      },
    },
    "prisma": "mantenimiento_preventivo.count",
  },
  {
    "args": {
      "_sum": {
        "costo_total": true,
      },
      "where": {
        "fecha_reparacion": {
          "gte": 2026-07-01T00:00:00.000Z,
          "lt": 2026-08-01T00:00:00.000Z,
        },
      },
    },
    "prisma": "reparacion.aggregate",
  },
  {
    "args": {
      "include": {
        "maquina": true,
      },
      "orderBy": {
        "fecha_falla": "desc",
      },
      "take": 6,
    },
    "prisma": "falla_maquina.findMany",
  },
  {
    "args": {
      "include": {
        "maquina": true,
      },
      "orderBy": {
        "fecha_programada": "asc",
      },
      "take": 6,
    },
    "prisma": "mantenimiento_preventivo.findMany",
  },
]
`;

