              {
                "tecnico_proveedor": {
                  "contains": "rodamiento",
                  "mode": "insensitive",
                },
              },
              {
                "falla_maquina": {
                  "descripcion": {
                    "contains": "rodamiento",
                    "mode": "insensitive",
                  },
                },
              },
              {
                "falla_maquina": {
                  "maquina": {
                    "nombre": {
                      "contains": "rodamiento",
                      "mode": "insensitive",
                    },
                  },
                },
              },
            ],
          },
          {
            "falla_maquina": {
              "maquina": {
                "nombre": {
                  "contains": "torno",
                  "mode": "insensitive",
                },
              },
            },
          },
          {
            "id_falla": {
              "contains": "FAL",
              "mode": "insensitive",
            },
          },
          {
            "estado_reparacion": "ejecutada",
          },
          {
            "fecha_reparacion": {
              "gte": 2026-07-01T00:00:00.000Z,
              "lt": 2026-08-01T00:00:00.000Z,
            },
          },
        ],
      },
    },
    "prisma": "reparacion.findMany",
  },
]
`;

