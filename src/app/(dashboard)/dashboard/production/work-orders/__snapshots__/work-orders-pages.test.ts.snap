exports[`/dashboard/production/work-orders/[id] > con entregas y pendiente: entrega lo pendiente y concilia > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "include": {
        "avance_orden": true,
        "campania_produccion": true,
        "cliente": true,
        "detalle_pedido": {
          "include": {
            "pedido": {
              "include": {
                "cliente": true,
              },
            },
          },
        },
        "movimiento_inventario": true,
        "producto": true,
        "requerimiento_orden_material": {
          "include": {
            "material": true,
          },
          "orderBy": {
            "id_requerimiento": "asc",
          },
        },
        "ruta_fabricacion": {
          "include": {
            "etapa_ruta": {
              "orderBy": {
                "orden_secuencia": "asc",
              },
              "where": {
                "estado": true,
              },
            },
          },
        },
        "usuario": {
          "select": {
            "apellidos": true,
            "nombres": true,
          },
        },
        "version_receta": {
          "include": {
            "detalle_receta": {
              "include": {
                "material": true,
              },
              "orderBy": {
                "id_detalle_receta": "asc",
              },
            },
            "receta_tecnica": true,
          },
        },
      },
      "where": {
        "id_orden_trabajo": "OTR00000001",
      },
    },
    "prisma": "orden_trabajo.findUnique",
  },
]
`;

