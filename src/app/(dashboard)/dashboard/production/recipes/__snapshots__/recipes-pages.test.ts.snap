exports[`/dashboard/production/recipes/[id]/versions > historial con cada estado > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "include": {
        "producto": true,
        "version_receta": {
          "include": {
            "_count": {
              "select": {
                "detalle_receta": true,
                "orden_trabajo": true,
              },
            },
            "detalle_receta": {
              "include": {
                "material": true,
              },
              "orderBy": {
                "id_detalle_receta": "asc",
              },
            },
            "usuario": {
              "select": {
                "apellidos": true,
                "nombres": true,
              },
            },
          },
          "orderBy": [
            {
              "fecha_version": "desc",
            },
            {
              "id_version_receta": "desc",
            },
          ],
        },
      },
      "where": {
        "id_receta": "REC00000001",
      },
    },
    "prisma": "receta_tecnica.findUnique",
  },
]
`;

