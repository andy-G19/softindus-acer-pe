        "detalle_receta": {
          "select": {
            "id_material": true,
          },
        },
        "receta_tecnica": {
          "include": {
            "producto": true,
          },
        },
      },
      "where": {
        "id_receta": "REC00000001",
        "id_version_receta": "VER00000001",
      },
    },
    "prisma": "version_receta.findFirst",
  },
  {
    "args": {
      "orderBy": [
        {
          "categoria": "asc",
