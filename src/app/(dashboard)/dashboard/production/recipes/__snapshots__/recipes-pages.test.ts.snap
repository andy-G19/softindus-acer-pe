exports[`/dashboard/production/recipes > todos los filtros > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "include": {
        "_count": {
          "select": {
            "version_receta": true,
          },
        },
        "producto": true,
        "version_receta": {
          "include": {
            "_count": {
              "select": {
                "detalle_receta": true,
                "orden_trabajo": true,
              },
            },
          },
          "orderBy": {
            "fecha_version": "desc",
          },
          "take": 1,
          "where": {
            "estado": "vigente",
          },
        },
      },
      "orderBy": {
        "fecha_creacion": "desc",
      },
      "where": {
        "AND": [
          {
            "OR": [
              {
                "id_receta": {
                  "contains": "reja",
                  "mode": "insensitive",
                },
              },
              {
                "nombre_receta": {
                  "contains": "reja",
                  "mode": "insensitive",
                },
              },
              {
                "producto": {
                  "nombre_producto": {
                    "contains": "reja",
                    "mode": "insensitive",
                  },
                },
              },
            ],
          },
          {
            "id_producto": "PRO00000001",
          },
          {
            "estado": "activa",
          },
        ],
      },
    },
    "prisma": "receta_tecnica.findMany",
  },
  {
    "args": {
      "orderBy": {
        "nombre_producto": "asc",
      },
      "select": {
        "id_producto": true,
        "nombre_producto": true,
      },
      "where": {
        "estado": true,
      },
    },
    "prisma": "producto.findMany",
  },
]
`;

