<input type="hidden" name="id_ruta" value="id_ruta-1"/>
<input type="hidden" name="id_etapa_ruta" value="id_etapa_ruta-1"/>
<input type="hidden" name="modo_tiempo" value="simultaneo"/>
<div>
<label for="nombre_etapa">Nombre de la etapa *</label>
<input id="nombre_etapa" required="" maxLength="100" placeholder="Ej. Corte de plancha" name="nombre_etapa" value="nombre_etapa-1"/>
</div>
<div>
<div>
<label for="orden_secuencia">Orden de ejecución *</label>
<input type="number" id="orden_secuencia" min="1" max="999" required="" name="orden_secuencia" value="1"/>
</div>
<div>
