exports[`/dashboard/production/routes/[id]/stages/[stageId]/edit > editar con maquina > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "include": {
        "_count": {
          "select": {
            "avance_orden": true,
            "tarea_operario": true,
          },
        },
        "etapa_ruta_maquina": {
          "select": {
            "id_maquina": true,
            "tiempo_maquina_minutos_unidad": true,
          },
        },
        "ruta_fabricacion": {
          "include": {
            "producto": true,
          },
        },
      },
      "where": {
        "id_etapa_ruta": "ETR00000001",
        "id_ruta": "RUT00000001",
      },
    },
    "prisma": "etapa_ruta.findFirst",
  },
  {
    "args": {
      "orderBy": {
        "nombre": "asc",
      },
      "select": {
        "estado": true,
        "id_maquina": true,
        "nombre": true,
        "tipo": true,
      },
      "where": {
        "OR": [
          {
            "estado": {
              "notIn": [
                "dada_de_baja",
                "inactiva",
              ],
            },
          },
          {
            "id_maquina": "id_maquina-1",
          },
        ],
      },
    },
    "prisma": "maquina.findMany",
  },
]
`;

