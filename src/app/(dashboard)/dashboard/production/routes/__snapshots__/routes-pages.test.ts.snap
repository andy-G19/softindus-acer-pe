exports[`/dashboard/production/routes/[id]/stages > filtros con maquina y activas > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "include": {
        "etapa_ruta": {
          "include": {
            "_count": {
              "select": {
                "avance_orden": true,
                "tarea_operario": true,
              },
            },
            "etapa_ruta_maquina": {
              "select": {
                "maquina": {
                  "select": {
                    "estado": true,
                    "nombre": true,
                  },
                },
                "tiempo_maquina_minutos_unidad": true,
              },
            },
          },
          "orderBy": {
            "orden_secuencia": "asc",
          },
          "where": {
            "AND": [
              {
                "nombre_etapa": {
                  "contains": "soldadura",
                  "mode": "insensitive",
                },
              },
              {
                "requiere_maquina": true,
              },
              {
                "estado": true,
              },
            ],
          },
        },
        "producto": true,
      },
      "where": {
        "id_ruta": "RUT00000001",
      },
    },
    "prisma": "ruta_fabricacion.findUnique",
  },
]
`;

