          "select": {
            "cantidad_objetivo": true,
            "cantidad_producida": true,
          },
        },
      },
      "orderBy": [
        {
          "fecha_inicio": "desc",
        },
        {
          "id_campania": "desc",
        },
      ],
      "where": {
        "AND": [
          {
            "fecha_inicio": {
              "lt": 2026-08-01T00:00:00.000Z,
            },
          },
        ],
      },
    },
    "prisma": "campania_produccion.findMany",
  },
  {
    "args": {
      "orderBy": {
        "nombre_producto": "asc",
      },
      "select": {
        "id_producto": true,
        "nombre_producto": true,
