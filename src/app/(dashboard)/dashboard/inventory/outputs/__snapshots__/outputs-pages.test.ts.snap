exports[`/dashboard/inventory/outputs/new > formulario > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "orderBy": {
        "nombre_material": "asc",
      },
      "select": {
        "id_material": true,
        "nombre_material": true,
        "stock_actual": true,
        "stock_reservado": true,
        "unidad_medida": true,
      },
      "where": {
        "estado": true,
      },
    },
    "prisma": "material.findMany",
  },
  {
    "args": {
      "orderBy": {
        "fecha_inicio": "desc",
      },
      "select": {
        "estado": true,
        "id_orden_trabajo": true,
      },
      "where": {
        "estado": {
          "notIn": [
            "finalizada",
            "cancelada",
          ],
        },
      },
    },
    "prisma": "orden_trabajo.findMany",
  },
]
`;

exports[`/dashboard/inventory/outputs/new > formulario > resultado 1`] = `
{
  "html": "<main>
<section>
<nav aria-label="Ruta de navegación">
<ol>
<li>
<a href="/dashboard">Dashboard</a>
</li>
<li>
<svg/>
<a href="/dashboard/inventory">Inventario</a>
</li>
<li>
<svg/>
<a href="/dashboard/inventory/outputs">Salidas</a>
</li>
<li>
<svg/>
<span aria-current="page">Registrar salida</span>
</li>
</ol>
</nav>
<div>
<div>
<div aria-hidden="true">
</div>
<div>
<h1>Registrar salida de inventario</h1>
<p>La salida descuenta stock actual y registra stock anterior/resultante.</p>
</div>
</div>
<div>
<button type="button" aria-label="Volver a salidas">
<svg/>Volver a salidas</button>
</div>
</div>
</section>
<form action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)">
<div>
<div>
<label for="id_material">Material</label>
<select id="id_material" name="id_material" required="">
<option value="">Seleccione material</option>
<option value="id_material-1">nombre_material-1 (0.00 unidad_medida-1 disponible)</option>
<option value="id_material-2">nombre_material-2 (0.00 unidad_medida-2 disponible)</option>
</select>
</div>
<div>
<label for="id_orden_trabajo">Orden de trabajo</label>
<select id="id_orden_trabajo" name="id_orden_trabajo">
<option value="">Sin orden asociada</option>
<option value="id_orden_trabajo-1">id_orden_trabajo-1 - estado-1</option>
<option value="id_orden_trabajo-2">id_orden_trabajo-2 - estado-2</option>
</select>
</div>
</div>
<div>
<label for="cantidad">Cantidad</label>
<input type="number" id="cantidad" min="0.01" step="0.01" required="" name="cantidad"/>
</div>
<div>
<label for="motivo">Motivo</label>
<textarea id="motivo" name="motivo" rows="4" required="">
</textarea>
</div>
<div>
<button data-variant="default" type="submit">Registrar salida</button>
<a data-variant="outline" href="/dashboard/inventory/outputs">Cancelar</a>
</div>
</form>
</main>
<script>addEventListener("submit",function(a){if(!a.defaultPrevented){var c=a.target,d=a.submitter,e=c.action,b=d;if(d){var f=d.getAttribute("formAction");null!=f&&(e=f,b=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===e&&(a.preventDefault(),b?(a=document.createElement("input"),a.name=b.name,a.value=b.value,b.parentNode.insertBefore(a,b),b=new FormData(c),a.parentNode.removeChild(a)):b=new FormData(c),a=c.ownerDocument||c,(a.$$reactFormReplay=a.$$reactFormReplay||[]).push(c,d,b))}});</script>",
  "outcome": "render",
}
`;

