  {
    "args": {
      "include": {
        "material": true,
        "usuario": true,
      },
      "orderBy": [
        {
          "fecha_movimiento": "desc",
        },
        {
          "id_movimiento": "desc",
        },
      ],
      "skip": 0,
      "take": 20,
      "where": {
        "AND": [
          {
            "tipo_movimiento": "salida",
          },
        ],
      },
    },
    "prisma": "movimiento_inventario.findMany",
  },
