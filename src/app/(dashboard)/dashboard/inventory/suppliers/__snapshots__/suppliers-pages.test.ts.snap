exports[`/dashboard/inventory/suppliers/[id]/edit > editar > resultado 1`] = `
{
  "html": "<main>
<section>
<nav aria-label="Ruta de navegación">
<ol>
<li>
<a href="/dashboard">Dashboard</a>
</li>
<li>
<svg/>
<a href="/dashboard/inventory">Inventario</a>
</li>
<li>
<svg/>
<a href="/dashboard/inventory/suppliers">Proveedores</a>
</li>
<li>
<svg/>
<span aria-current="page">Editar proveedor</span>
</li>
</ol>
</nav>
<div>
<div>
<div aria-hidden="true">
</div>
<div>
<h1>Editar proveedor</h1>
<p>Actualiza los datos comerciales del proveedor.</p>
</div>
</div>
<div>
<button type="button" aria-label="Volver a proveedores">
<svg/>Volver a proveedores</button>
</div>
</div>
</section>
<form action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)">
<input type="hidden" name="id_proveedor" value="id_proveedor-1"/>
<div>
<label for="razon_social">Razón social *</label>
<input id="razon_social" required="" placeholder="Ej. Aceros del Sur S.A.C." name="razon_social" value="razon_social-1"/>
</div>
<div>
<div>
<label for="tipo_documento">Tipo de documento</label>
<select id="tipo_documento" name="tipo_documento">
<option value="">Sin documento</option>
<option value="ruc">RUC</option>
<option value="dni">DNI</option>
<option value="otro">Otro</option>
</select>
</div>
<div>
<label for="numero_documento">Número de documento</label>
<input id="numero_documento" placeholder="Ej. 20601234567" name="numero_documento" value="numero_documento-1"/>
</div>
</div>
<div>
<div>
<label for="telefono">Teléfono</label>
<input id="telefono" placeholder="Ej. 999 888 777" name="telefono" value="telefono-1"/>
</div>
<div>
<label for="correo">Correo</label>
<input type="email" id="correo" placeholder="proveedor@correo.com" name="correo" value="correo-1"/>
</div>
</div>
<div>
<label for="direccion">Dirección</label>
<input id="direccion" placeholder="Dirección comercial" name="direccion" value="direccion-1"/>
</div>
<div>
<div>
<label for="contacto_principal">Contacto principal</label>
<input id="contacto_principal" placeholder="Nombre de la persona de contacto" name="contacto_principal" value="contacto_principal-1"/>
</div>
<div>
<label for="tipo_proveedor">Tipo de proveedor *</label>
<select id="tipo_proveedor" name="tipo_proveedor" required="">
<option value="">Selecciona un tipo</option>
<option value="slug-1">nombre-1</option>
<option value="slug-2">nombre-2</option>
</select>
</div>
</div>
<div>
<label for="condicion_pago">Condición de pago</label>
<select id="condicion_pago" name="condicion_pago">
<option value="">No especificado</option>
<option value="contado">Contado</option>
<option value="credito">Crédito</option>
<option value="parcial">Parcial</option>
<option value="otro">Otro</option>
</select>
</div>
<div>
<label for="observaciones">Observaciones</label>
<textarea id="observaciones" name="observaciones" rows="4" placeholder="Notas adicionales sobre el proveedor">observaciones-1</textarea>
</div>
<div>
<a data-variant="link" href="/dashboard/inventory/suppliers">Cancelar</a>
<button data-variant="default" type="submit">Guardar cambios</button>
</div>
