[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "orderBy": {
        "razon_social": "asc",
      },
      "select": {
        "condicion_pago": true,
        "estado": true,
        "id_proveedor": true,
        "numero_documento": true,
        "razon_social": true,
        "telefono": true,
        "tipo_documento": true,
        "tipo_proveedor": true,
      },
      "where": {
        "AND": [
          {
            "OR": [
              {
                "id_proveedor": {
                  "contains": "acero",
                  "mode": "insensitive",
                },
              },
              {
                "razon_social": {
                  "contains": "acero",
                  "mode": "insensitive",
                },
              },
              {
                "numero_documento": {
                  "contains": "acero",
                  "mode": "insensitive",
                },
              },
              {
                "telefono": {
                  "contains": "acero",
                  "mode": "insensitive",
                },
              },
            ],
          },
          {
            "tipo_proveedor": "distribuidor",
          },
          {
            "condicion_pago": "contado",
          },
          {
            "estado": true,
          },
        ],
      },
    },
    "prisma": "proveedor.findMany",
  },
  {
    "args": {
      "orderBy": {
        "nombre": "asc",
      },
      "select": {
        "nombre": true,
        "slug": true,
      },
    },
    "prisma": "tipo_proveedor_catalogo.findMany",
  },
  {
    "args": {
      "distinct": [
        "condicion_pago",
      ],
      "orderBy": {
        "condicion_pago": "asc",
      },
      "select": {
        "condicion_pago": true,
      },
      "where": {
        "condicion_pago": {
          "not": null,
        },
      },
    },
    "prisma": "proveedor.findMany",
  },
]
`;

