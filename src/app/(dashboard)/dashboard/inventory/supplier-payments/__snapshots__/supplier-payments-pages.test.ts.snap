exports[`/dashboard/inventory/supplier-payments > todos los filtros > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "include": {
        "compra": {
          "include": {
            "proveedor": true,
          },
        },
      },
      "orderBy": {
        "fecha_pago": "desc",
      },
      "where": {
        "AND": [
          {
            "OR": [
              {
                "id_compra": {
                  "contains": "F001",
                  "mode": "insensitive",
                },
              },
              {
                "compra": {
                  "numero_comprobante": {
                    "contains": "F001",
                    "mode": "insensitive",
                  },
                },
              },
              {
                "compra": {
                  "proveedor": {
                    "razon_social": {
                      "contains": "F001",
                      "mode": "insensitive",
                    },
                  },
                },
              },
            ],
          },
          {
            "id_proveedor": "PRV00000001",
          },
          {
            "id_compra": "COM00000001",
          },
          {
            "metodo_pago": "transferencia",
          },
          {
            "estado_pago": "pagado",
          },
          {
            "fecha_pago": {
              "gte": 2026-07-01T00:00:00.000Z,
              "lt": 2026-08-01T00:00:00.000Z,
            },
          },
        ],
      },
    },
    "prisma": "pago_proveedor.findMany",
  },
  {
    "args": {
      "orderBy": {
        "razon_social": "asc",
      },
      "select": {
        "id_proveedor": true,
        "razon_social": true,
      },
    },
    "prisma": "proveedor.findMany",
  },
  {
    "args": {
      "orderBy": {
        "fecha_compra": "desc",
      },
      "select": {
        "id_compra": true,
      },
    },
    "prisma": "compra.findMany",
  },
]
`;

