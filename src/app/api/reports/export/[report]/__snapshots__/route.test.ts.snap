exports[`GET /api/reports/export/[report] > archivos por reporte > rentabilidad: alias de la pantalla con margen bajo y utilidad negativa 1`] = `
{
  "calls": [
    {
      "args": {
        "include": {
          "margen_ganancia": {
            "orderBy": {
              "fecha_aplicacion": "desc",
            },
            "take": 1,
          },
          "orden_trabajo": {
            "include": {
              "cliente": true,
              "producto": true,
            },
          },
          "pedido": {
            "include": {
              "cliente": true,
            },
          },
          "rentabilidad": {
            "orderBy": {
              "fecha_calculo": "desc",
            },
            "take": 1,
          },
        },
        "orderBy": [
          {
            "fecha_costeo": "desc",
          },
          {
            "id_costeo": "desc",
          },
        ],
        "take": 1000,
        "where": {
          "OR": [
            {
              "id_costeo": {
                "contains": "Estructura",
                "mode": "insensitive",
              },
            },
            {
              "id_pedido": {
                "contains": "Estructura",
                "mode": "insensitive",
              },
            },
            {
              "id_orden_trabajo": {
                "contains": "Estructura",
                "mode": "insensitive",
              },
            },
            {
              "pedido": {
                "cliente": {
                  "nombre_razon_social": {
                    "contains": "Estructura",
                    "mode": "insensitive",
                  },
                },
              },
            },
            {
              "orden_trabajo": {
                "producto": {
                  "nombre_producto": {
                    "contains": "Estructura",
                    "mode": "insensitive",
                  },
                },
              },
            },
          ],
          "fecha_costeo": {
            "gte": 2026-07-01T00:00:00.000Z,
            "lt": 2026-08-01T00:00:00.000Z,
          },
          "rentabilidad": {
            "some": {
              "utilidad_estimada": {
                "lt": 0,
              },
            },
          },
        },
      },
      "prisma": "costeo.findMany",
    },
    {
      "args": null,
      "effect": "prisma.$transaction",
    },
    {
      "args": {
        "codigoEntidad": "exportacion_datos",
        "prefijo": "EXP",
      },
      "effect": "getNextCorrelativeId",
    },
    {
      "args": {
        "data": {
          "estado": "generada",
          "formato": "excel",
          "id_exportacion": "EXP00000007",
          "id_usuario": "USU00000001",
          "modulo_origen": "Reporte de costos y rentabilidad",
          "parametros": "{"q":"Estructura","from":"2026-07-01","to":"2026-07-31","lowMargin":"true","negativeProfit":"true"}",
          "ruta_archivo": "costos_rentabilidad_2026-07-15.xlsx",
        },
      },
      "prisma": "exportacion_datos.create",
    },
    {
      "args": {
        "accion": "crear",
        "detalle": "Reporte exportado: Reporte de costos y rentabilidad (excel). Registros: 2.",
        "enTransaccion": true,
