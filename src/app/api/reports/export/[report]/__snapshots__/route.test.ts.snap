exports[`GET /api/reports/export/[report] > archivos por reporte > auditoria: alias de la pantalla 1`] = `
{
  "calls": [
    {
      "args": {
        "include": {
          "usuario": {
            "select": {
              "apellidos": true,
              "nombres": true,
            },
          },
        },
        "orderBy": [
          {
            "fecha_hora": "desc",
          },
          {
            "id_bitacora": "desc",
          },
        ],
        "take": 1000,
        "where": {
          "OR": [
            {
              "detalle": {
                "contains": "CLI",
                "mode": "insensitive",
              },
            },
            {
              "entidad_afectada": {
                "contains": "CLI",
                "mode": "insensitive",
              },
            },
            {
              "accion": {
                "contains": "CLI",
                "mode": "insensitive",
              },
            },
            {
              "id_registro_afectado": {
                "contains": "CLI",
                "mode": "insensitive",
              },
            },
          ],
          "accion": "crear",
          "entidad_afectada": "cliente",
          "fecha_hora": {
            "gte": 2026-07-01T00:00:00.000Z,
            "lt": 2026-08-01T00:00:00.000Z,
          },
          "id_usuario": "USU00000002",
        },
      },
      "prisma": "bitacora_operacion.findMany",
    },
    {
      "args": null,
      "effect": "prisma.$transaction",
    },
    {
      "args": {
        "codigoEntidad": "exportacion_datos",
        "prefijo": "EXP",
      },
      "effect": "getNextCorrelativeId",
    },
    {
      "args": {
        "data": {
          "estado": "generada",
          "formato": "excel",
          "id_exportacion": "EXP00000007",
          "id_usuario": "USU00000001",
          "modulo_origen": "Reporte de auditoria",
          "parametros": "{"q":"CLI","usuario":"USU00000002","accion":"crear","entidad":"cliente","from":"2026-07-01","to":"2026-07-31"}",
          "ruta_archivo": "auditoria_2026-07-15.xlsx",
        },
      },
      "prisma": "exportacion_datos.create",
    },
    {
      "args": {
        "accion": "crear",
        "detalle": "Reporte exportado: Reporte de auditoria (excel). Registros: 2.",
        "enTransaccion": true,
        "entidad_afectada": "exportacion_datos",
        "id_registro_afectado": "EXP00000007",
        "userId": "USU00000001",
      },
      "effect": "registerAuditLog",
    },
    {
      "args": {
        "headers": [
          "Fecha",
          "Usuario",
          "Accion",
          "Entidad",
          "Registro",
          "Detalle",
          "IP",
        ],
        "metadata": "Generado: 15/7/2026, 3:00:00 p. m. | Filtros: q=CLI, usuario=USU00000002, accion=crear, entidad=cliente, from=2026-07-01, to=2026-07-31 | Total exportado: 2 | Límite aplicado: 1000",
        "rows": [
          [
            "30 jun. 2026, 7:00 p. m.",
            "apellidos-1, nombres-1",
            "accion-1",
            "entidad_afectada-1",
            "id_registro_afectado-1",
            "detalle-1",
            "ip_origen-1",
          ],
          [
            "1 jul. 2026, 7:00 p. m.",
            "apellidos-2, nombres-2",
            "accion-2",
            "entidad_afectada-2",
            "",
            "",
            "",
          ],
        ],
        "title": "Reporte de Auditoria",
      },
      "effect": "buildExcelBuffer",
    },
  ],
  "response": {
    "body": "contenido excel",
    "cacheControl": "no-store",
    "contentDisposition": "attachment; filename="auditoria_2026-07-15.xlsx"",
    "contentType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "status": 200,
  },
}
`;

