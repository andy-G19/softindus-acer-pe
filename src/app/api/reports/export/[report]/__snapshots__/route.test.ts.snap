                },
              },
            },
          },
          "usuario": {
            "select": {
              "apellidos": true,
              "nombres": true,
            },
          },
        },
        "orderBy": [
          {
            "fecha_falla": "desc",
          },
          {
            "id_falla": "desc",
          },
        ],
        "take": 500,
        "where": {
          "OR": [
            {
              "descripcion": {
                "contains": "MAQ-01",
                "mode": "insensitive",
              },
            },
            {
              "responsable_registro": {
                "contains": "MAQ-01",
                "mode": "insensitive",
              },
            },
