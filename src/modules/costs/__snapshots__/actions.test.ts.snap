  },
  {
    "args": {
      "data": {
        "alerta_bajo_margen": true,
        "costo_total": 1500.14,
        "id_costeo": "COS00000004",
        "id_pedido": "PED00000003",
        "id_rentabilidad": "REN00000001",
        "ingreso_estimado": 1700,
        "margen_real": 13.322756542722672,
        "observaciones": "Rentabilidad calculada automáticamente usando el último margen aplicado.",
        "utilidad_estimada": 199.8599999999999,
      },
    },
    "prisma": "rentabilidad.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Rentabilidad calculada para el costeo COS00000004. Utilidad estimada: S/ 199.86.",
      "enTransaccion": true,
      "entidad_afectada": "rentabilidad",
      "id_registro_afectado": "REN00000001",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/costs",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/costs/costings",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/costs/costings/COS00000004",
    "effect": "revalidatePath",
  },
]
`;

