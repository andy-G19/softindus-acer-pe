[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_orden_trabajo FROM aceros.orden_trabajo WHERE id_orden_trabajo = $1 FOR NO KEY UPDATE",
      "values": [
        "OTR00000007",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "select": {
        "id_costeo": true,
      },
      "where": {
        "id_orden_trabajo": "OTR00000007",
      },
    },
    "prisma": "costeo.findFirst",
  },
  {
    "args": {
      "include": {
        "detalle_pedido": true,
        "producto": true,
        "version_receta": {
          "include": {
            "detalle_receta": {
              "include": {
                "material": true,
              },
            },
            "receta_tecnica": true,
          },
        },
      },
      "where": {
        "id_orden_trabajo": "OTR00000007",
      },
    },
    "prisma": "orden_trabajo.findUnique",
  },
  {
    "args": {
      "include": {
        "operario": {
          "select": {
            "tarifa": true,
          },
        },
      },
      "where": {
        "estado": {
          "not": "anulada",
        },
        "id_orden_trabajo": "OTR00000007",
      },
    },
    "prisma": "tarea_operario.findMany",
  },
  {
    "args": {
      "codigoEntidad": "costeo",
      "prefijo": "COS",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "cantidad_base": 25,
        "costo_consumibles": 248.355275,
        "costo_indirecto_total": 0,
        "costo_mano_obra": 157.4375,
        "costo_materiales": 1762.9375,
        "costo_total": 2168.730275,
        "costo_unitario": 86.749211,
        "id_costeo": "COS00000001",
        "id_orden_trabajo": "OTR00000007",
        "id_pedido": "PED00000003",
        "id_usuario_registro": "USU00000001",
        "observaciones": "Costeo generado automáticamente desde orden de trabajo usando la versión de receta guardada en la orden, costo actual de materiales y mano de obra estimada desde tareas de operario.",
      },
    },
    "prisma": "costeo.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Costeo creado desde la orden de trabajo OTR00000007. Mano de obra estimada: S/ 157.44.",
      "enTransaccion": true,
      "entidad_afectada": "costeo",
      "id_registro_afectado": "COS00000001",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/costs",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/costs/costings",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/costs/work-orders",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/costs/costings/COS00000001",
    "effect": "revalidatePath",
  },
