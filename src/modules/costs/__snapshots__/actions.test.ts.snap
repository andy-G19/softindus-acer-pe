exports[`createProfitabilityAction > costo con centimos: fija el orden de la formula del margen real > llamadas 1`] = `
[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_costeo FROM aceros.costeo WHERE id_costeo = $1 FOR NO KEY UPDATE",
      "values": [
        "COS00000004",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "include": {
        "margen_ganancia": {
          "orderBy": {
            "fecha_aplicacion": "desc",
          },
          "take": 1,
        },
      },
      "where": {
        "id_costeo": "COS00000004",
      },
    },
    "prisma": "costeo.findUnique",
  },
  {
    "args": {
      "codigoEntidad": "rentabilidad",
      "prefijo": "REN",
    },
