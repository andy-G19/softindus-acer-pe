// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`createRecipeVersionAction > ADMIN crea la version vigente y reemplaza la anterior > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_receta FROM aceros.receta_tecnica WHERE id_receta = $1 FOR NO KEY UPDATE",
      "values": [
        "REC00000003",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "select": {
        "id_receta": true,
      },
      "where": {
        "estado": "activa",
        "id_receta": "REC00000003",
      },
    },
    "prisma": "receta_tecnica.findFirst",
  },
  {
    "args": {
      "select": {
        "id_material": true,
        "unidad_medida": true,
      },
      "where": {
        "estado": true,
        "id_material": {
          "in": [
            "MAT00000001",
            "MAT00000002",
          ],
        },
      },
    },
    "prisma": "material.findMany",
  },
  {
    "args": {
      "select": {
        "numero_version": true,
      },
      "where": {
        "id_receta": "REC00000003",
      },
    },
    "prisma": "version_receta.findMany",
  },
  {
    "args": {
      "select": {
        "id_version_receta": true,
      },
      "where": {
        "id_receta": "REC00000003",
        "numero_version": "V3",
      },
    },
    "prisma": "version_receta.findFirst",
  },
  {
    "args": {
      "codigoEntidad": "version_receta",
      "prefijo": "VER",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "cantidad": 2,
      "codigoEntidad": "detalle_receta",
      "prefijo": "DRE",
    },
    "effect": "getNextCorrelativeIds",
  },
  {
    "args": {
      "data": {
        "estado": "reemplazada",
      },
      "where": {
        "estado": "vigente",
        "id_receta": "REC00000003",
      },
    },
    "prisma": "version_receta.updateMany",
  },
  {
    "args": {
      "data": {
        "estado": "vigente",
        "id_receta": "REC00000003",
        "id_usuario_aprueba": "USU00000001",
        "id_version_receta": "VER00000012",
        "motivo_cambio": "Cambio de proveedor",
        "numero_version": "V3",
      },
    },
    "prisma": "version_receta.create",
  },
  {
    "args": {
      "data": [
        {
          "cantidad_requerida": 2.5,
          "id_detalle_receta": "DRE00000012",
          "id_material": "MAT00000001",
          "id_version_receta": "VER00000012",
          "merma_estimada_porcentaje": 5,
          "observaciones": null,
          "tipo_consumo": "materia_prima",
          "unidad_medida": "kg",
        },
        {
          "cantidad_requerida": 1,
          "id_detalle_receta": "DRE00000013",
          "id_material": "MAT00000002",
          "id_version_receta": "VER00000012",
          "merma_estimada_porcentaje": 0,
          "observaciones": "Solo primera mano",
          "tipo_consumo": "consumible",
          "unidad_medida": "gl",
        },
      ],
    },
    "prisma": "detalle_receta.createMany",
  },
  {
    "args": {
      "accion": "CREAR_VERSION_RECETA",
      "detalle": "Nueva versión vigente V3 creada para la receta REC00000003 con 2 material(es).",
      "enTransaccion": true,
      "entidad_afectada": "version_receta",
      "id_registro_afectado": "VER00000012",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/recipes",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/recipes/REC00000003/versions",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/work-orders",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/recipes/REC00000003/versions/VER00000012/details",
    "effect": "revalidatePath",
  },
]
`;

