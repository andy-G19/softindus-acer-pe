exports[`voidRecipeVersionAction > la vigente se anula y promueve la mas reciente no anulada > llamadas 1`] = `
[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_receta FROM aceros.receta_tecnica WHERE id_receta = $1 FOR NO KEY UPDATE",
      "values": [
        "REC00000003",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "include": {
        "orden_trabajo": {
          "select": {
            "id_orden_trabajo": true,
          },
        },
      },
      "where": {
        "id_receta": "REC00000003",
        "id_version_receta": "VER00000005",
      },
    },
    "prisma": "version_receta.findFirst",
  },
  {
    "args": {
      "orderBy": [
        {
          "fecha_version": "desc",
        },
        {
          "id_version_receta": "desc",
        },
      ],
      "select": {
        "id_version_receta": true,
      },
      "where": {
        "estado": {
          "not": "anulada",
        },
        "id_receta": "REC00000003",
        "id_version_receta": {
          "not": "VER00000005",
        },
      },
    },
    "prisma": "version_receta.findFirst",
  },
  {
    "args": {
      "data": {
        "estado": "anulada",
      },
      "where": {
