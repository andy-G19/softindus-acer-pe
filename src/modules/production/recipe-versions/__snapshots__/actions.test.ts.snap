exports[`setCurrentRecipeVersionAction > WORKSHOP_MASTER tambien la marca > llamadas 1`] = `
[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_receta FROM aceros.receta_tecnica WHERE id_receta = $1 FOR NO KEY UPDATE",
      "values": [
        "REC00000003",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "include": {
        "receta_tecnica": true,
      },
      "where": {
        "id_receta": "REC00000003",
        "id_version_receta": "VER00000005",
      },
    },
    "prisma": "version_receta.findFirst",
  },
  {
    "args": {
      "data": {
        "estado": "reemplazada",
      },
      "where": {
        "estado": "vigente",
        "id_receta": "REC00000003",
      },
    },
    "prisma": "version_receta.updateMany",
  },
  {
    "args": {
      "data": {
        "estado": "vigente",
        "id_usuario_aprueba": "USU00000001",
      },
      "where": {
        "id_version_receta": "VER00000005",
      },
    },
    "prisma": "version_receta.update",
  },
  {
    "args": {
      "accion": "CAMBIAR_VERSION_VIGENTE",
      "detalle": "La versión V2 fue marcada como vigente para la receta REC00000003.",
      "enTransaccion": true,
      "entidad_afectada": "version_receta",
      "id_registro_afectado": "VER00000005",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/recipes",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/recipes/REC00000003/versions",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/work-orders",
    "effect": "revalidatePath",
  },
]
`;

