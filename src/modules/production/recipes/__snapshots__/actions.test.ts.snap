// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`createTechnicalRecipeAction > ADMIN crea la receta activa con su correlativo y la bitacora en la transaccion > llamadas 1`] = `
[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "select": {
        "id_producto": true,
        "nombre_producto": true,
      },
      "where": {
        "estado": true,
        "id_producto": "PRO00000004",
      },
    },
    "prisma": "producto.findFirst",
  },
  {
    "args": {
      "where": {
        "id_producto": "PRO00000004",
        "nombre_receta": "Receta estandar de lampa",
      },
    },
    "prisma": "receta_tecnica.findFirst",
  },
  {
    "args": {
      "codigoEntidad": "receta_tecnica",
      "prefijo": "REC",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "descripcion": "Materiales principales",
        "estado": "activa",
        "id_producto": "PRO00000004",
        "id_receta": "REC00000012",
        "id_usuario_creacion": "USU00000001",
        "nombre_receta": "Receta estandar de lampa",
      },
    },
    "prisma": "receta_tecnica.create",
  },
  {
    "args": {
      "accion": "CREAR_RECETA",
      "detalle": "Receta técnica creada para el producto Lampa.",
      "enTransaccion": true,
      "entidad_afectada": "receta_tecnica",
      "id_registro_afectado": "REC00000012",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/production",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/recipes",
    "effect": "revalidatePath",
  },
]
`;

