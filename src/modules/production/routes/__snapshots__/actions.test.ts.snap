exports[`createFabricationRouteAction > ADMIN crea la ruta activa con su correlativo y la bitacora en la transaccion > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "select": {
        "id_producto": true,
        "nombre_producto": true,
      },
      "where": {
        "estado": true,
        "id_producto": "PRO00000004",
      },
    },
    "prisma": "producto.findFirst",
  },
  {
    "args": {
      "where": {
        "id_producto": "PRO00000004",
        "nombre_ruta": "Ruta estandar para lampa",
      },
    },
    "prisma": "ruta_fabricacion.findFirst",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "ruta_fabricacion",
      "prefijo": "RUT",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "descripcion": "Corte, formado y pintura",
        "estado": true,
        "id_producto": "PRO00000004",
        "id_ruta": "RUT00000012",
        "nombre_ruta": "Ruta estandar para lampa",
      },
    },
    "prisma": "ruta_fabricacion.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Ruta creada: Ruta estandar para lampa",
      "enTransaccion": true,
      "entidad_afectada": "ruta_fabricacion",
      "id_registro_afectado": "RUT00000012",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/production",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/routes",
    "effect": "revalidatePath",
  },
]
`;

