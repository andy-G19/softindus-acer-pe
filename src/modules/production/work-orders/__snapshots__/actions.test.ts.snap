exports[`createWorkOrderAction > campania inexistente o no activa > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": {
      "select": {
        "id_producto": true,
        "nombre_producto": true,
      },
      "where": {
        "estado": true,
        "id_producto": "PRO00000001",
      },
    },
    "prisma": "producto.findFirst",
  },
  {
    "args": {
      "include": {
        "etapa_ruta": {
          "where": {
            "estado": true,
          },
        },
      },
      "where": {
        "estado": true,
        "id_ruta": "RUT00000001",
      },
    },
    "prisma": "ruta_fabricacion.findFirst",
  },
  {
    "args": {
      "include": {
        "detalle_receta": {
          "include": {
            "material": {
              "select": {
                "costo_unitario_actual": true,
                "id_material": true,
              },
            },
          },
          "orderBy": {
            "id_detalle_receta": "asc",
          },
        },
        "receta_tecnica": true,
      },
      "where": {
        "id_version_receta": "VRE00000001",
      },
    },
    "prisma": "version_receta.findFirst",
  },
  {
    "args": {
      "include": {
        "campania_detalle": {
          "select": {
            "id_producto": true,
          },
        },
      },
      "where": {
        "estado": {
          "in": [
            "planificada",
            "activa",
          ],
        },
        "id_campania": "CAM00000001",
      },
    },
    "prisma": "campania_produccion.findFirst",
  },
]
