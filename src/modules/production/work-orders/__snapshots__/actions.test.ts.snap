        "fecha_atencion": 2026-07-15T15:00:00.000Z,
        "id_usuario_atencion": "USU00000001",
        "mensaje": "El material Plancha LAC 1/16 recupero stock por encima del minimo.",
        "stock_detectado": 22.25,
      },
      "where": {
        "id_alerta": "ALE00000003",
      },
    },
    "prisma": "alerta_stock.update",
  },
  {
    "args": {
      "accion": "devolver_material",
      "detalle": "Devolucion de 2.25 kg de Plancha LAC 1/16. Motivo: Sobro una plancha entera",
      "enTransaccion": true,
      "entidad_afectada": "orden_trabajo",
      "id_registro_afectado": "OTR00000007",
      "userId": "USU00000001",
