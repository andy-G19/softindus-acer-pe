[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_orden_trabajo FROM aceros.orden_trabajo WHERE id_orden_trabajo = $1 FOR NO KEY UPDATE",
      "values": [
        "OTR00000007",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "include": {
        "material": true,
        "orden_trabajo": {
          "select": {
            "estado": true,
            "fecha_cierre_materiales": true,
            "id_orden_trabajo": true,
          },
        },
      },
      "where": {
        "id_requerimiento": "ROM00000001",
      },
    },
    "prisma": "requerimiento_orden_material.findUnique",
  },
  {
    "args": {
      "cantidad": 1,
      "codigoEntidad": "movimiento_inventario",
      "prefijo": "MVI",
    },
    "effect": "getNextCorrelativeIds",
  },
  {
    "args": {
      "data": {
        "stock_actual": {
          "decrement": 5.5,
        },
      },
      "where": {
        "id_material": "MAT00000001",
        "stock_actual": {
          "gte": 5.5,
        },
      },
    },
    "prisma": "material.updateMany",
  },
  {
    "args": {
      "data": {
        "cantidad": 5.5,
        "id_material": "MAT00000001",
        "id_movimiento": "MVI00000001",
        "id_orden_trabajo": "OTR00000007",
        "id_usuario_responsable": "USU00000001",
        "motivo": "Entrega adicional a la orden OTR00000007: Se rompio una pieza al cortar",
        "stock_anterior": 40,
        "stock_resultante": 34.5,
        "tipo_movimiento": "salida",
      },
    },
    "prisma": "movimiento_inventario.create",
  },
  {
    "args": {
      "data": {
        "cantidad_entregada": {
          "increment": 5.5,
        },
      },
      "where": {
        "id_requerimiento": "ROM00000001",
      },
    },
    "prisma": "requerimiento_orden_material.update",
  },
  {
    "args": {
      "select": {
        "id_alerta": true,
      },
      "where": {
        "estado_alerta": "activa",
        "id_material": "MAT00000001",
      },
    },
    "prisma": "alerta_stock.findFirst",
  },
  {
    "args": {
      "accion": "entrega_adicional",
      "detalle": "Entrega adicional de 5.50 kg de Plancha LAC 1/16. Motivo: Se rompio una pieza al cortar",
      "enTransaccion": true,
      "entidad_afectada": "orden_trabajo",
      "id_registro_afectado": "OTR00000007",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/inventory",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/work-orders/OTR00000007",
    "effect": "revalidatePath",
  },
]
`;

