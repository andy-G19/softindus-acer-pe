exports[`returnWorkOrderMaterialAction > orden finalizada: devuelve con motivo y atiende la alerta > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
