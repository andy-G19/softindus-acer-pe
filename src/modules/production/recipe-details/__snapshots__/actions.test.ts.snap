exports[`createRecipeDetailAction > ADMIN agrega el material con la unidad del inventario > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "select": {
        "id_receta": true,
      },
      "where": {
        "id_version_receta": "VER00000005",
      },
    },
    "prisma": "version_receta.findUnique",
  },
  {
    "args": {
      "sql": "SELECT id_receta FROM aceros.receta_tecnica WHERE id_receta = $1 FOR NO KEY UPDATE",
      "values": [
        "REC00000003",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "include": {
        "orden_trabajo": {
          "select": {
            "id_orden_trabajo": true,
          },
        },
        "receta_tecnica": true,
      },
      "where": {
        "estado": "vigente",
        "id_version_receta": "VER00000005",
      },
    },
    "prisma": "version_receta.findFirst",
  },
  {
    "args": {
      "select": {
        "id_material": true,
        "nombre_material": true,
        "unidad_medida": true,
      },
      "where": {
        "estado": true,
        "id_material": "MAT00000001",
      },
    },
    "prisma": "material.findFirst",
  },
  {
    "args": {
      "where": {
        "id_material": "MAT00000001",
        "id_version_receta": "VER00000005",
      },
    },
    "prisma": "detalle_receta.findFirst",
  },
  {
    "args": {
      "codigoEntidad": "detalle_receta",
      "prefijo": "DRE",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "cantidad_requerida": 2.5,
        "id_detalle_receta": "DRE00000012",
        "id_material": "MAT00000001",
        "id_version_receta": "VER00000005",
        "merma_estimada_porcentaje": 5,
        "observaciones": "Plancha entera",
        "tipo_consumo": "materia_prima",
        "unidad_medida": "kg",
      },
    },
    "prisma": "detalle_receta.create",
  },
  {
    "args": {
      "accion": "MODIFICAR_DETALLE_RECETA",
      "detalle": "Material Plancha de acero agregado a la versión VER00000005.",
      "enTransaccion": true,
      "entidad_afectada": "detalle_receta",
      "id_registro_afectado": "DRE00000012",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/recipes",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/recipes/REC00000003/versions",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/production/recipes/REC00000003/versions/VER00000005/details",
    "effect": "revalidatePath",
  },
]
`;

