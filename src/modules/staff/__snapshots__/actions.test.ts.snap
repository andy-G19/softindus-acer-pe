        "apellidos": {
          "equals": "Huaman",
          "mode": "insensitive",
        },
        "nombres": {
          "equals": "Luis",
          "mode": "insensitive",
        },
        "telefono": "987654321",
      },
    },
    "prisma": "operario.findFirst",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "operario",
      "prefijo": "OPE",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "apellidos": "Huaman",
        "cargo": "Soldador",
        "direccion": "Av. Industrial 123",
        "especialidad": "Soldadura MIG",
        "estado": "activo",
        "fecha_ingreso": 2026-03-02T00:00:00.000Z,
        "id_operario": "OPE00000012",
        "modalidad_pago": "semanal",
        "nombres": "Luis",
        "observaciones": null,
        "tarifa": 80.5,
        "telefono": "987654321",
      },
    },
    "prisma": "operario.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Operario creado: Luis Huaman",
      "enTransaccion": true,
      "entidad_afectada": "operario",
      "id_registro_afectado": "OPE00000012",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/staff",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/staff/operators",
    "effect": "revalidatePath",
  },
]
