[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_operario FROM aceros.operario WHERE id_operario = $1 FOR NO KEY UPDATE",
      "values": [
        "OPE00000003",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "select": {
        "id_operario": true,
      },
      "where": {
        "id_operario": "OPE00000003",
      },
    },
    "prisma": "operario.findUnique",
  },
  {
    "args": {
      "select": {
        "id_operario": true,
      },
      "where": {
        "apellidos": {
          "equals": "Huaman",
          "mode": "insensitive",
        },
        "nombres": {
          "equals": "Luis",
          "mode": "insensitive",
        },
        "telefono": "987654321",
      },
    },
    "prisma": "operario.findFirst",
  },
  {
    "args": {
      "data": {
        "apellidos": "Huaman",
        "cargo": "Soldador",
        "direccion": "Av. Industrial 123",
        "especialidad": "Soldadura MIG",
        "fecha_ingreso": 2026-03-02T00:00:00.000Z,
        "modalidad_pago": "semanal",
        "nombres": "Luis",
        "observaciones": null,
        "tarifa": 80.5,
        "telefono": "987654321",
      },
      "where": {
        "id_operario": "OPE00000003",
      },
    },
    "prisma": "operario.update",
  },
  {
    "args": {
      "accion": "actualizar",
      "detalle": "Operario actualizado: Luis Huaman",
