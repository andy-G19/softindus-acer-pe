      "entidad_afectada": "operario",
      "id_registro_afectado": "OPE00000003",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/staff",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/staff/operators",
    "effect": "revalidatePath",
  },
]
`;

