        "estado_pago": "anulada",
      },
      "where": {
        "id_planilla": "PLA00000009",
      },
    },
    "prisma": "planilla_pago.update",
  },
  {
    "args": {
      "accion": "anular",
      "detalle": "Planilla anulada para el operario OPE00000003.",
      "enTransaccion": true,
      "entidad_afectada": "planilla_pago",
      "id_registro_afectado": "PLA00000009",
      "userId": "USU00000001",
