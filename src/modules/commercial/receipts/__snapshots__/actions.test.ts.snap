exports[`annulReceiptAction > el id con espacios se recorta > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "SELLER",
    ],
  },
  {
    "args": {
      "where": {
        "id_comprobante": "CMP00000003",
      },
    },
    "prisma": "comprobante_venta.findUnique",
  },
  {
    "args": {
      "data": {
        "estado": "anulado",
      },
      "where": {
        "id_comprobante": "CMP00000003",
      },
    },
    "fueraDeTransaccion": true,
    "prisma": "comprobante_venta.update",
  },
  {
    "args": {
      "accion": "anular",
      "detalle": "Comprobante anulado: B001-000123",
      "enTransaccion": false,
      "entidad_afectada": "comprobante_venta",
      "id_registro_afectado": "CMP00000003",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": "/dashboard/commercial/receipts",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/commercial/quotes",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/commercial/quotes/PRF00000007",
    "effect": "revalidatePath",
  },
]
`;

