exports[`createReceiptAction > boleta por el total de la proforma > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "SELLER",
    ],
  },
  {
    "args": {
      "include": {
        "comprobante_venta": {
          "select": {
            "id_comprobante": true,
            "numero_comprobante": true,
          },
          "where": {
            "estado": "emitido",
          },
        },
      },
      "where": {
        "id_proforma": "PRF00000007",
      },
    },
    "prisma": "proforma.findUnique",
  },
  {
    "args": {
      "select": {
        "id_comprobante": true,
      },
      "where": {
        "numero_comprobante": "B001-000123",
      },
    },
    "prisma": "comprobante_venta.findUnique",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "comprobante_venta",
      "prefijo": "CMP",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "estado": "emitido",
        "fecha_emision": 2026-07-15T15:00:00.000Z,
        "id_comprobante": "CMP00000001",
        "id_pedido": "PED00000004",
        "id_proforma": "PRF00000007",
        "monto_total": 150.5,
        "numero_comprobante": "B001-000123",
        "observaciones": null,
        "tipo_comprobante": "boleta",
      },
    },
    "prisma": "comprobante_venta.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Comprobante registrado: B001-000123",
      "enTransaccion": true,
      "entidad_afectada": "comprobante_venta",
      "id_registro_afectado": "CMP00000001",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/commercial/quotes",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/commercial/quotes/PRF00000007",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/commercial/orders",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/commercial/receipts",
    "effect": "revalidatePath",
  },
]
`;

exports[`createReceiptAction > boleta por el total de la proforma > resultado 1`] = `"redirect:/dashboard/commercial/quotes/PRF00000007?toast=receipt-created"`;

