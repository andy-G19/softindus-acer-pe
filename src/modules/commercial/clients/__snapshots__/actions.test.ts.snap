      "SELLER",
    ],
  },
  {
    "args": {
      "select": {
        "id_cliente": true,
      },
      "where": {
        "numero_documento": "20123456789",
      },
    },
    "prisma": "cliente.findUnique",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "cliente",
      "prefijo": "CLI",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "correo": "compras@andina.pe",
        "direccion": "Av. Industrial 123",
        "estado": true,
        "id_cliente": "CLI00000008",
        "lugar_origen": "Arequipa",
        "nombre_razon_social": "Ferreteria Andina SAC",
        "numero_documento": "20123456789",
        "observaciones": "Paga al contado",
        "telefono": "987654321",
        "tipo_cliente": "ferreteria",
        "tipo_documento": "ruc",
      },
    },
    "prisma": "cliente.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Cliente creado: Ferreteria Andina SAC",
      "enTransaccion": true,
      "entidad_afectada": "cliente",
      "id_registro_afectado": "CLI00000008",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/commercial/clients",
    "effect": "revalidatePath",
  },
]
`;

