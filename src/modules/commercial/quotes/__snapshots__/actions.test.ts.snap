            "id_comprobante": true,
          },
          "where": {
            "estado": "emitido",
          },
        },
        "pago_cliente": {
          "select": {
            "id_pago_cliente": true,
          },
        },
      },
      "where": {
        "id_proforma": "PRF00000007",
      },
    },
    "prisma": "proforma.findUnique",
  },
  {
    "args": {
      "data": {
        "estado": "anulada",
      },
      "where": {
        "id_proforma": "PRF00000007",
      },
    },
    "fueraDeTransaccion": true,
    "prisma": "proforma.update",
