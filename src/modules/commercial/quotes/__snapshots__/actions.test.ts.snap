exports[`createQuoteAction > adelanto cero: nace vigente sin pago > llamadas 1`] = `
[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
      "SELLER",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "data": [
        {
          "clave": "5f0c2b7e-8d41-4c3a-9b6e-1a2b3c4d5e6f",
          "id_usuario": "USU00000001",
          "tipo_operacion": "crear_proforma",
        },
      ],
      "select": {
        "clave": true,
      },
      "skipDuplicates": true,
    },
    "prisma": "operacion_idempotente.createManyAndReturn",
  },
  {
    "args": {
      "sql": "SELECT id_pedido FROM aceros.pedido WHERE id_pedido = $1 FOR NO KEY UPDATE",
      "values": [
        "PED00000004",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "include": {
        "detalle_pedido": {
          "select": {
            "subtotal": true,
          },
        },
        "proforma": {
          "select": {
            "estado": true,
            "id_proforma": true,
            "numero_proforma": true,
          },
          "where": {
            "estado": {
              "in": [
                "vigente",
                "aceptada",
                "pagada",
              ],
            },
          },
        },
      },
      "where": {
        "id_pedido": "PED00000004",
      },
    },
    "prisma": "pedido.findUnique",
  },
  {
    "args": {
      "codigoEntidad": "proforma",
      "prefijo": "PRF",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "adelanto_inicial": null,
        "estado": "vigente",
        "fecha_emision": 2026-07-15T15:00:00.000Z,
        "id_pedido": "PED00000004",
        "id_proforma": "PRF00000001",
        "monto_total": "150.50",
        "numero_proforma": "PF-00000001",
        "observaciones": null,
        "saldo": "150.50",
        "validez_dias": 15,
      },
    },
    "prisma": "proforma.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Proforma creada para el pedido PED00000004.",
      "enTransaccion": true,
      "entidad_afectada": "proforma",
      "id_registro_afectado": "PRF00000001",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": {
      "data": {
        "id_registro_resultado": "PRF00000001",
      },
      "where": {
        "clave": "5f0c2b7e-8d41-4c3a-9b6e-1a2b3c4d5e6f",
      },
    },
    "prisma": "operacion_idempotente.updateMany",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/commercial/quotes",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/commercial/orders",
    "effect": "revalidatePath",
  },
]
`;

