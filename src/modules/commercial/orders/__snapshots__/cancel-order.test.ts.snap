// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cancelOrderAction > anulado: vuelve al listado > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "SELLER",
    ],
  },
  {
    "args": {
      "include": {
        "comprobante_venta": {
          "select": {
            "id_comprobante": true,
          },
        },
        "detalle_pedido": {
          "include": {
            "orden_trabajo": {
              "select": {
                "id_orden_trabajo": true,
              },
            },
          },
        },
        "proforma": {
          "select": {
            "id_proforma": true,
          },
        },
      },
      "where": {
        "id_pedido": "PED00000004",
      },
    },
    "prisma": "pedido.findUnique",
  },
]
`;

exports[`cancelOrderAction > anulado: vuelve al listado > resultado 1`] = `"redirect:/dashboard/commercial/orders"`;

exports[`cancelOrderAction > aprobado: lo cancela > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "SELLER",
    ],
  },
  {
    "args": {
      "include": {
        "comprobante_venta": {
          "select": {
            "id_comprobante": true,
          },
        },
        "detalle_pedido": {
          "include": {
            "orden_trabajo": {
              "select": {
                "id_orden_trabajo": true,
              },
            },
          },
        },
        "proforma": {
          "select": {
            "id_proforma": true,
          },
        },
      },
      "where": {
        "id_pedido": "PED00000004",
      },
    },
    "prisma": "pedido.findUnique",
  },
  {
    "args": {
      "data": {
        "estado": "cancelado",
      },
      "where": {
        "id_pedido": "PED00000004",
      },
    },
    "fueraDeTransaccion": true,
    "prisma": "pedido.update",
  },
  {
    "args": {
      "accion": "cancelar",
      "detalle": "Pedido cancelado: PED00000004",
      "enTransaccion": false,
      "entidad_afectada": "pedido",
      "id_registro_afectado": "PED00000004",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": "/dashboard/commercial/orders",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/commercial/orders/PED00000004",
    "effect": "revalidatePath",
  },
]
`;

exports[`cancelOrderAction > aprobado: lo cancela > resultado 1`] = `"redirect:/dashboard/commercial/orders?toast=order-cancelled"`;

