      "codigoEntidad": "pedido",
      "prefijo": "PED",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "cantidad": 2,
      "codigoEntidad": "detalle_pedido",
      "prefijo": "DPE",
    },
    "effect": "getNextCorrelativeIds",
  },
  {
    "args": {
      "data": {
        "estado": "registrado",
        "fecha_entrega_estimada": 2026-07-20T00:00:00.000Z,
