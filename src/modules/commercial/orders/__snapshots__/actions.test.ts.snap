        "id_cliente": "CLI00000003",
        "id_pedido": "PED00000010",
        "id_usuario_registro": "USU00000001",
        "monto_estimado": "380.50",
        "observaciones": "Entrega en obra.",
      },
    },
    "prisma": "pedido.create",
  },
  {
