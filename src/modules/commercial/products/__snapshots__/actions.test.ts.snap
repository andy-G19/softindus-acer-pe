exports[`createProductAction > ADMIN crea el producto activo con su correlativo y la bitacora dentro de la transaccion > llamadas 1`] = `
[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "select": {
        "estado": true,
      },
      "where": {
        "slug": "herramientas",
      },
    },
    "prisma": "categoria_producto.findUnique",
  },
  {
    "args": {
      "select": {
        "id_producto": true,
      },
      "where": {
        "nombre_producto": "Lampa agrícola reforzada",
      },
    },
    "prisma": "producto.findUnique",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "producto",
      "prefijo": "PRO",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "categoria": "herramientas",
        "descripcion": "Mango de eucalipto.",
        "estado": true,
        "id_producto": "PRO00000010",
        "nombre_producto": "Lampa agrícola reforzada",
        "precio_referencial": 35.5,
        "unidad_medida": "unidad",
      },
    },
    "prisma": "producto.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Producto creado: Lampa agrícola reforzada",
      "enTransaccion": true,
      "entidad_afectada": "producto",
      "id_registro_afectado": "PRO00000010",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/commercial/products",
    "effect": "revalidatePath",
  },
]
`;

