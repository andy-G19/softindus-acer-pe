  },
  {
    "args": {
      "sql": "SELECT id_usuario FROM aceros.usuario WHERE id_usuario = $1 FOR NO KEY UPDATE",
      "values": [
        "USU00000002",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "select": {
        "estado": true,
        "id_usuario": true,
        "rol": {
          "select": {
            "nombre_rol": true,
          },
        },
      },
      "where": {
        "id_usuario": "USU00000002",
      },
    },
    "prisma": "usuario.findUnique",
  },
  {
    "args": {
      "select": {
        "id_rol": true,
      },
      "where": {
        "nombre_rol": "SELLER",
      },
    },
    "prisma": "rol.findUnique",
  },
  {
    "args": {
      "select": {
        "correo": true,
        "usuario": true,
      },
      "where": {
        "OR": [
          {
            "correo": "ana.quispe@example.com",
          },
          {
            "usuario": "aquispe",
          },
        ],
        "id_usuario": {
          "not": "USU00000002",
        },
      },
    },
    "prisma": "usuario.findFirst",
  },
  {
    "args": {
      "data": {
        "apellidos": "Quispe",
        "correo": "ana.quispe@example.com",
        "estado": "activo",
        "id_rol": "id_rol-1",
        "nombres": "Ana",
        "usuario": "aquispe",
      },
      "where": {
        "id_usuario": "USU00000002",
      },
    },
    "prisma": "usuario.update",
  },
  {
    "args": {
      "accion": "actualizar",
      "detalle": "Usuario actualizado: USU00000002",
      "enTransaccion": true,
      "entidad_afectada": "usuario",
      "id_registro_afectado": "USU00000002",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/users",
    "effect": "revalidatePath",
  },
]
`;

