exports[`updateUserAction > ADMIN actualiza los datos sin cambiar el rol: una bitacora > llamadas 1`] = `
[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_usuario FROM aceros.usuario WHERE id_usuario = $1 FOR NO KEY UPDATE",
      "values": [
        "USU00000002",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "select": {
        "id_usuario": true,
        "rol": {
          "select": {
            "nombre_rol": true,
          },
        },
      },
      "where": {
        "id_usuario": "USU00000002",
      },
    },
    "prisma": "usuario.findUnique",
  },
  {
    "args": {
      "select": {
        "id_rol": true,
      },
      "where": {
        "nombre_rol": "SELLER",
      },
    },
    "prisma": "rol.findUnique",
  },
  {
    "args": {
      "select": {
        "correo": true,
        "usuario": true,
      },
      "where": {
        "OR": [
          {
            "correo": "ana.quispe@example.com",
          },
          {
            "usuario": "aquispe",
          },
        ],
        "id_usuario": {
          "not": "USU00000002",
        },
      },
    },
    "prisma": "usuario.findFirst",
  },
  {
    "args": {
      "data": {
        "apellidos": "Quispe",
        "correo": "ana.quispe@example.com",
        "id_rol": "id_rol-1",
        "nombres": "Ana",
        "usuario": "aquispe",
      },
      "select": {
        "id_usuario": true,
      },
      "where": {
        "id_usuario": "USU00000002",
      },
    },
    "prisma": "usuario.update",
  },
  {
    "args": {
      "accion": "actualizar",
      "detalle": "Usuario actualizado: USU00000002",
      "enTransaccion": true,
      "entidad_afectada": "usuario",
      "id_registro_afectado": "USU00000002",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/users",
    "effect": "revalidatePath",
  },
]
`;

