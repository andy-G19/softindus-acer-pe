exports[`activateUserAction > activar un usuario inactivo escribe con su bitacora en la transaccion > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "data": {
        "estado": "activo",
      },
      "where": {
        "estado": {
          "not": "activo",
        },
        "id_usuario": "USU00000002",
      },
    },
    "prisma": "usuario.updateMany",
  },
  {
    "args": {
      "accion": "activar",
      "detalle": "Usuario activado: USU00000002",
      "enTransaccion": true,
      "entidad_afectada": "usuario",
      "id_registro_afectado": "USU00000002",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/users",
    "effect": "revalidatePath",
  },
]
`;

