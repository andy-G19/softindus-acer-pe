exports[`createUserAction > ADMIN crea el usuario activo con su hash, correlativo y bitacora en la transaccion > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "select": {
        "id_rol": true,
      },
      "where": {
        "nombre_rol": "SELLER",
      },
    },
    "prisma": "rol.findUnique",
  },
  {
    "args": {
      "select": {
        "correo": true,
        "usuario": true,
      },
      "where": {
        "OR": [
          {
            "correo": "ana.quispe@example.com",
          },
          {
            "usuario": "aquispe",
          },
        ],
      },
    },
    "prisma": "usuario.findFirst",
  },
  {
    "args": {
      "bytes": 13,
      "cost": 10,
    },
    "effect": "bcrypt.hash",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "usuario",
      "prefijo": "USU",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "apellidos": "Quispe",
        "clave_hash": "$2b$10$hash-de-prueba",
        "correo": "ana.quispe@example.com",
        "estado": "activo",
        "id_rol": "id_rol-1",
        "id_usuario": "USU00000012",
        "nombres": "Ana",
        "usuario": "aquispe",
      },
    },
    "prisma": "usuario.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Usuario creado: ana.quispe@example.com",
      "enTransaccion": true,
      "entidad_afectada": "usuario",
      "id_registro_afectado": "USU00000012",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/users",
    "effect": "revalidatePath",
  },
]
`;

exports[`createUserAction > ADMIN crea el usuario activo con su hash, correlativo y bitacora en la transaccion > resultado 1`] = `"redirect:/dashboard/users?toast=user-created"`;

