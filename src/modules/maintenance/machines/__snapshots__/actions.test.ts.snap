  {
    "args": {
      "data": {
        "codigo_interno": "PH-60",
        "estado": "operativa",
        "nombre": "Prensa hidraulica 60 t (nave 2)",
        "observaciones": "Revisar mangueras cada mes",
        "tipo": "prensa",
        "ubicacion": "Nave 2",
      },
      "where": {
        "id_maquina": "MAQ00000004",
      },
    },
    "fueraDeTransaccion": true,
    "prisma": "maquina.update",
  },
  {
    "args": {
      "accion": "actualizar",
      "detalle": "Maquina actualizada: Prensa hidraulica 60 t (nave 2)",
      "enTransaccion": false,
      "entidad_afectada": "maquina",
      "id_registro_afectado": "MAQ00000004",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": "/dashboard/maintenance",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/maintenance/machines",
    "effect": "revalidatePath",
  },
]
`;

