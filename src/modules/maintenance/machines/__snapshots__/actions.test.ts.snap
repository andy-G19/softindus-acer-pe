        "id_maquina": true,
      },
      "where": {
        "id_maquina": "MAQ00000004",
      },
    },
    "prisma": "maquina.findUnique",
  },
  {
    "args": {
      "select": {
        "id_maquina": true,
      },
      "where": {
        "OR": [
          {
            "AND": [
              {
                "nombre": {
                  "equals": "Prensa hidraulica 60 t (nave 2)",
                  "mode": "insensitive",
                },
              },
              {
                "tipo": {
                  "equals": "prensa",
                  "mode": "insensitive",
                },
              },
            ],
          },
          {
            "codigo_interno": "PH-60",
          },
        ],
      },
    },
