exports[`createMachineAction > crea la maquina con su correlativo y la bitacora dentro de la transaccion > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "select": {
        "id_maquina": true,
      },
      "where": {
        "OR": [
          {
            "AND": [
              {
                "nombre": {
                  "equals": "Prensa hidraulica 60 t",
                  "mode": "insensitive",
                },
              },
              {
                "tipo": {
                  "equals": "prensa",
                  "mode": "insensitive",
                },
              },
            ],
          },
          {
            "codigo_interno": "PH-60",
          },
        ],
      },
    },
    "prisma": "maquina.findFirst",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "maquina",
      "prefijo": "MAQ",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "codigo_interno": "PH-60",
        "estado": "operativa",
        "id_maquina": "MAQ00000008",
        "nombre": "Prensa hidraulica 60 t",
        "observaciones": "Revisar mangueras cada mes",
        "tipo": "prensa",
        "ubicacion": "Nave 1",
      },
    },
    "prisma": "maquina.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Maquina creada: Prensa hidraulica 60 t",
      "enTransaccion": true,
      "entidad_afectada": "maquina",
      "id_registro_afectado": "MAQ00000008",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/maintenance",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/maintenance/machines",
    "effect": "revalidatePath",
  },
]
`;

exports[`createMachineAction > crea la maquina con su correlativo y la bitacora dentro de la transaccion > resultado 1`] = `"redirect:/dashboard/maintenance/machines?toast=machine-created"`;

