  },
  {
    "args": {
      "select": {
        "estado": true,
        "id_maquina": true,
      },
      "where": {
        "id_maquina": "MAQ00000003",
      },
    },
    "prisma": "maquina.findUnique",
  },
  {
    "args": {
      "codigoEntidad": "falla_maquina",
      "prefijo": "FAL",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "descripcion": "El husillo vibra al pasar de 800 rpm",
        "estado_atencion": "pendiente",
        "fecha_falla": 2026-07-14T09:30:00.000Z,
        "id_falla": "FAL00000012",
        "id_maquina": "MAQ00000003",
        "id_usuario_registro": "USU00000001",
        "impacto_produccion": "Se detuvo el torneado de bridas",
        "responsable_registro": "Juan Quispe",
        "tiempo_perdido_horas": 2.5,
      },
    },
    "prisma": "falla_maquina.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Falla registrada para la maquina MAQ00000003.",
