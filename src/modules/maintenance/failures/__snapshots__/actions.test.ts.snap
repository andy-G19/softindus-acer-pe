exports[`createFailureAction > ADMIN registra la falla con su correlativo y la bitacora dentro de la transaccion > llamadas 1`] = `
[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_maquina FROM aceros.maquina WHERE id_maquina = $1 FOR NO KEY UPDATE",
      "values": [
        "MAQ00000003",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "select": {
        "estado": true,
        "id_maquina": true,
      },
      "where": {
        "id_maquina": "MAQ00000003",
      },
    },
    "prisma": "maquina.findUnique",
  },
  {
    "args": {
      "codigoEntidad": "falla_maquina",
      "prefijo": "FAL",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "descripcion": "El husillo vibra al pasar de 800 rpm",
        "estado_atencion": "pendiente",
        "fecha_falla": 2026-07-14T09:30:00.000Z,
        "id_falla": "FAL00000012",
        "id_maquina": "MAQ00000003",
        "id_usuario_registro": "USU00000001",
        "impacto_produccion": "Se detuvo el torneado de bridas",
        "responsable_registro": "Juan Quispe",
        "tiempo_perdido_horas": 2.5,
      },
    },
    "prisma": "falla_maquina.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Falla registrada para la maquina MAQ00000003.",
      "enTransaccion": true,
      "entidad_afectada": "falla_maquina",
      "id_registro_afectado": "FAL00000012",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/maintenance",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/maintenance/failures",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/maintenance/machines",
    "effect": "revalidatePath",
  },
]
`;

