    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_maquina FROM aceros.maquina WHERE id_maquina = $1 FOR NO KEY UPDATE",
      "values": [
        "MAQ00000003",
      ],
    },
