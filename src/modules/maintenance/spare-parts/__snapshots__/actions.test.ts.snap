exports[`createSparePartAction > crea el repuesto con su proveedor, su correlativo y la bitacora dentro de la transaccion > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "select": {
        "id_proveedor": true,
      },
      "where": {
        "estado": true,
        "id_proveedor": "PVE00000003",
      },
    },
    "prisma": "proveedor.findFirst",
  },
  {
    "args": {
      "select": {
        "id_repuesto": true,
      },
      "where": {
        "nombre_repuesto": {
          "equals": "Faja en V B-52",
          "mode": "insensitive",
        },
      },
    },
    "prisma": "repuesto.findFirst",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "repuesto",
      "prefijo": "REP",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "costo_unitario": 38.5,
        "descripcion": "Para el motor de la cizalla",
        "estado": true,
        "id_proveedor": "PVE00000003",
        "id_repuesto": "REP00000008",
        "nombre_repuesto": "Faja en V B-52",
      },
    },
    "prisma": "repuesto.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Repuesto creado: Faja en V B-52",
      "enTransaccion": true,
      "entidad_afectada": "repuesto",
      "id_registro_afectado": "REP00000008",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/maintenance",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/maintenance/spare-parts",
    "effect": "revalidatePath",
  },
]
`;

exports[`createSparePartAction > crea el repuesto con su proveedor, su correlativo y la bitacora dentro de la transaccion > resultado 1`] = `"redirect:/dashboard/maintenance/spare-parts?toast=spare-part-created"`;

