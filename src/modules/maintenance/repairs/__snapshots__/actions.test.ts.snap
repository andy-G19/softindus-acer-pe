exports[`createRepairAction > anulada al crear no toca la falla ni la maquina > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_falla FROM aceros.falla_maquina WHERE id_falla = $1 FOR NO KEY UPDATE",
      "values": [
        "FAL00000007",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "include": {
        "maquina": true,
      },
      "where": {
        "id_falla": "FAL00000007",
      },
    },
    "prisma": "falla_maquina.findUnique",
  },
  {
    "args": {
      "codigoEntidad": "reparacion",
      "prefijo": "RPA",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "costo_total": "150.50",
        "estado_reparacion": "anulada",
        "fecha_reparacion": 2026-07-16T00:00:00.000Z,
        "id_falla": "FAL00000007",
        "id_reparacion": "RPA00000021",
        "mano_obra": "150.50",
        "observaciones": "Cambiar rodamientos del cabezal",
        "tecnico_proveedor": "Servicios Electromecanicos Lima",
      },
    },
    "prisma": "reparacion.create",
  },
  {
    "args": {
      "cantidad": 0,
      "codigoEntidad": "detalle_repuesto_reparacion",
      "prefijo": "DRP",
    },
    "effect": "getNextCorrelativeIds",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Reparacion registrada para la falla FAL00000007.",
      "enTransaccion": true,
      "entidad_afectada": "reparacion",
      "id_registro_afectado": "RPA00000021",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/maintenance",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/maintenance/repairs",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/maintenance/failures",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/maintenance/machines",
    "effect": "revalidatePath",
  },
]
`;

