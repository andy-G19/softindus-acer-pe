        "id_orden_trabajo": "OTR00000003",
        "observaciones": "Corte de planchas",
        "peso_kg": 12.5,
        "tipo_material": "Acero",
      },
    },
    "prisma": "chatarra.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Chatarra registrada: Acero",
      "enTransaccion": true,
      "entidad_afectada": "chatarra",
      "id_registro_afectado": "CHA00000012",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/waste-scrap",
    "effect": "revalidatePath",
  },
]
`;

exports[`createScrapAction > una orden finalizada se admite > resultado 1`] = `"redirect:/dashboard/waste-scrap?toast=scrap-created"`;
