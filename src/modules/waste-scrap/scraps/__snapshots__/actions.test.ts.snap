exports[`createScrapAction > ADMIN registra la chatarra acumulada con la bitacora en la transaccion > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_orden_trabajo FROM aceros.orden_trabajo WHERE id_orden_trabajo = $1 FOR NO KEY UPDATE",
      "values": [
        "OTR00000003",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "select": {
        "estado": true,
        "id_material": true,
      },
      "where": {
        "id_material": "MAT00000002",
      },
    },
    "prisma": "material.findUnique",
  },
  {
    "args": {
      "select": {
        "estado": true,
        "id_orden_trabajo": true,
      },
      "where": {
        "id_orden_trabajo": "OTR00000003",
      },
    },
    "prisma": "orden_trabajo.findUnique",
  },
  {
    "args": {
      "codigoEntidad": "chatarra",
      "prefijo": "CHA",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "cantidad": 3,
        "estado": "acumulada",
        "id_chatarra": "CHA00000012",
        "id_material": "MAT00000002",
        "id_orden_trabajo": "OTR00000003",
        "observaciones": "Corte de planchas",
        "peso_kg": 12.5,
        "tipo_material": "Acero",
      },
    },
    "prisma": "chatarra.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Chatarra registrada: Acero",
      "enTransaccion": true,
      "entidad_afectada": "chatarra",
      "id_registro_afectado": "CHA00000012",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/waste-scrap",
    "effect": "revalidatePath",
  },
]
`;

