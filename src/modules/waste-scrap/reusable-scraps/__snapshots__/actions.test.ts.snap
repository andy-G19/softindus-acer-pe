      "values": [
        "OTR00000003",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "select": {
        "categoria": true,
        "estado": true,
        "id_material": true,
        "nombre_material": true,
        "unidad_medida": true,
      },
      "where": {
        "id_material": "MAT00000002",
      },
    },
    "prisma": "material.findUnique",
  },
  {
    "args": {
      "select": {
        "estado": true,
        "id_orden_trabajo": true,
      },
      "where": {
        "id_orden_trabajo": "OTR00000003",
      },
    },
    "prisma": "orden_trabajo.findUnique",
  },
  {
    "args": {
      "codigoEntidad": "retazo_reutilizable",
      "prefijo": "RET",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "cantidad": 2,
        "estado": "disponible",
        "id_material": "MAT00000002",
        "id_orden_trabajo": "OTR00000003",
        "id_retazo": "RET00000012",
        "id_usuario_registro": "USU00000001",
        "medida_aproximada": "30 cm x 15 cm",
        "tipo_material": "planchas",
        "ubicacion": "Estante A",
        "unidad_medida": "pieza",
      },
    },
    "prisma": "retazo_reutilizable.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Retazo reutilizable creado para el material MAT00000002.",
      "enTransaccion": true,
      "entidad_afectada": "retazo_reutilizable",
      "id_registro_afectado": "RET00000012",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/waste-scrap",
    "effect": "revalidatePath",
  },
]
`;

