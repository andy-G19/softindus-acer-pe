// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`createPettyCashBoxAction > caja valida: la abre con su saldo inicial como saldo actual > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "where": {
        "nombre_caja": {
          "equals": "Caja almacen",
          "mode": "insensitive",
        },
      },
    },
    "prisma": "caja_chica.findFirst",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "caja_chica",
      "prefijo": "CAJ",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "estado": "abierta",
        "fecha_apertura": 2026-11-10T00:00:00.000Z,
        "id_caja_chica": "CAJ00000001",
        "nombre_caja": "Caja almacen",
        "observaciones": null,
        "responsable": null,
        "saldo_actual": 250.4,
        "saldo_inicial": 250.4,
      },
    },
    "prisma": "caja_chica.create",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/petty-cash",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/petty-cash/boxes",
    "effect": "revalidatePath",
  },
]
`;

exports[`createPettyCashBoxAction > caja valida: la abre con su saldo inicial como saldo actual > resultado 1`] = `"redirect:/dashboard/petty-cash/boxes?toast=petty-cash-box-created"`;

