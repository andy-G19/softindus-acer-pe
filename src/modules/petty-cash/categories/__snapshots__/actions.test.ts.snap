        "id_categoria_gasto": true,
      },
      "where": {
        "nombre_categoria": {
          "equals": "Fletes y movilidad",
          "mode": "insensitive",
        },
      },
    },
    "prisma": "categoria_gasto.findFirst",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "categoria_gasto",
      "prefijo": "CGA",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "descripcion": "Taxis y envios del taller.",
        "estado": true,
        "id_categoria_gasto": "CGA00000010",
        "nombre_categoria": "Fletes y movilidad",
      },
    },
    "prisma": "categoria_gasto.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Categoria de gasto creada: Fletes y movilidad",
      "enTransaccion": true,
      "entidad_afectada": "categoria_gasto",
      "id_registro_afectado": "CGA00000010",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/petty-cash",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/petty-cash/categories",
    "effect": "revalidatePath",
  },
]
`;

