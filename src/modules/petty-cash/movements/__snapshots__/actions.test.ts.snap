  },
  {
    "args": {
      "data": {
        "saldo_actual": {
          "increment": 40.25,
        },
      },
      "where": {
        "id_caja_chica": "CAJ00000002",
      },
    },
    "prisma": "caja_chica.update",
  },
  {
    "args": {
      "accion": "anular",
      "detalle": "Movimiento de caja anulado: Ajuste negativo: Faltante.",
