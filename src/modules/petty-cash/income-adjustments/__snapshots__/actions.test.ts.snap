exports[`createPettyCashIncomeAdjustmentAction > ajuste negativo por todo el saldo: descuenta > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "sql": "SELECT id_caja_chica FROM aceros.caja_chica WHERE id_caja_chica = $1 FOR NO KEY UPDATE",
      "values": [
        "CAJ00000002",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "select": {
        "estado": true,
        "id_caja_chica": true,
        "nombre_caja": true,
        "saldo_actual": true,
      },
      "where": {
        "id_caja_chica": "CAJ00000002",
      },
    },
    "prisma": "caja_chica.findUnique",
  },
  {
    "args": {
      "codigoEntidad": "movimiento_caja",
      "prefijo": "MCA",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "comprobante": null,
        "concepto": "Ajuste negativo: Faltante de arqueo",
        "fecha_movimiento": 2026-11-10T00:00:00.000Z,
        "id_caja_chica": "CAJ00000002",
        "id_movimiento_caja": "MCA00000001",
        "id_usuario_registro": "USU00000001",
        "monto": "100.00",
        "observaciones": "Dirección del ajuste: disminución.",
        "responsable": "Usuario de prueba",
        "tipo_movimiento": "ajuste",
      },
    },
    "prisma": "movimiento_caja.create",
  },
  {
    "args": {
      "data": {
        "saldo_actual": {
          "decrement": "100.00",
        },
      },
      "where": {
        "id_caja_chica": "CAJ00000002",
      },
    },
    "prisma": "caja_chica.update",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Movimiento de caja registrado: Ajuste negativo: Faltante de arqueo.",
      "enTransaccion": true,
      "entidad_afectada": "movimiento_caja",
      "id_registro_afectado": "MCA00000001",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/petty-cash",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/petty-cash/boxes",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/petty-cash/income-adjustments/new",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/petty-cash/movements",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/petty-cash/monthly-summary",
    "effect": "revalidatePath",
  },
]
`;

exports[`createPettyCashIncomeAdjustmentAction > ajuste negativo por todo el saldo: descuenta > resultado 1`] = `"redirect:/dashboard/petty-cash?toast=petty-cash-income-registered"`;

