// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`attendStockAlertAction > ADMIN atiende una alerta activa > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "where": {
        "id_alerta": "ALE00000003",
      },
    },
    "prisma": "alerta_stock.findUnique",
  },
  {
    "args": {
      "data": {
        "estado_alerta": "atendida",
        "fecha_atencion": 2026-07-15T15:00:00.000Z,
        "id_usuario_atencion": "USU00000001",
      },
      "where": {
        "id_alerta": "ALE00000003",
      },
    },
    "fueraDeTransaccion": true,
    "prisma": "alerta_stock.update",
  },
  {
    "args": "/dashboard/inventory",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/inventory/alerts",
    "effect": "revalidatePath",
  },
]
`;

exports[`attendStockAlertAction > ADMIN atiende una alerta activa > resultado 1`] = `"redirect:/dashboard/inventory/alerts?toast=stock-alert-attended"`;

