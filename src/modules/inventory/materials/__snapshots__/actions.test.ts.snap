exports[`createMaterialAction > con mas de dos decimales decide con la fila guardada: 5.004 queda en 5.00, igual al minimo, y abre la alerta > llamadas 1`] = `
[
  {
    "authz": "requireRole",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "select": {
        "estado": true,
      },
      "where": {
        "slug": "planchas",
      },
    },
    "prisma": "categoria_material.findUnique",
  },
  {
    "args": {
      "select": {
        "id_material": true,
      },
      "where": {
        "nombre_material": "Plancha LAC 1/16",
      },
    },
    "prisma": "material.findUnique",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "material",
      "prefijo": "MAT",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "categoria": "planchas",
        "costo_unitario_actual": 185.5,
        "estado": true,
        "id_material": "MAT00000008",
        "nombre_material": "Plancha LAC 1/16",
        "stock_actual": 5.004,
        "stock_minimo": 5,
        "stock_reservado": 0,
        "unidad_medida": "unidad",
      },
      "select": {
        "stock_actual": true,
        "stock_minimo": true,
      },
    },
    "prisma": "material.create",
  },
  {
    "args": {
      "codigoEntidad": "movimiento_inventario",
      "prefijo": "MVI",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "cantidad": Decimal(5),
        "id_material": "MAT00000008",
        "id_movimiento": "MVI00000008",
        "id_usuario_responsable": "USU00000001",
        "motivo": "Stock inicial registrado al crear el material",
        "stock_anterior": 0,
        "stock_resultante": Decimal(5),
        "tipo_movimiento": "entrada",
      },
    },
    "prisma": "movimiento_inventario.create",
  },
  {
    "args": {
      "codigoEntidad": "alerta_stock",
      "prefijo": "ALE",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "estado_alerta": "activa",
        "id_alerta": "ALE00000008",
        "id_material": "MAT00000008",
        "mensaje": "El material Plancha LAC 1/16 está en stock bajo.",
        "stock_detectado": Decimal(5),
        "stock_minimo": Decimal(5),
      },
    },
    "prisma": "alerta_stock.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Material creado: Plancha LAC 1/16",
      "enTransaccion": true,
      "entidad_afectada": "material",
      "id_registro_afectado": "MAT00000008",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/inventory",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/inventory/materials",
    "effect": "revalidatePath",
  },
]
`;

