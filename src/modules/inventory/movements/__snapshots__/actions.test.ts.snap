exports[`createInventoryOutputAction > con orden en proceso: la asocia al movimiento y a la bitacora > llamadas 1`] = `
[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
      "WORKSHOP_MASTER",
    ],
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "data": [
        {
          "clave": "0b6f1d9e-3c4a-4f2b-9e7d-5a6b7c8d9e0f",
          "id_usuario": "USU00000001",
          "tipo_operacion": "registrar_salida",
        },
      ],
      "select": {
        "clave": true,
      },
      "skipDuplicates": true,
    },
    "prisma": "operacion_idempotente.createManyAndReturn",
  },
  {
    "args": {
      "sql": "SELECT id_orden_trabajo FROM aceros.orden_trabajo WHERE id_orden_trabajo = $1 FOR NO KEY UPDATE",
      "values": [
        "OTR00000007",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "select": {
        "estado": true,
        "fecha_cierre_materiales": true,
        "id_orden_trabajo": true,
      },
      "where": {
        "id_orden_trabajo": "OTR00000007",
      },
    },
    "prisma": "orden_trabajo.findUnique",
  },
  {
    "args": {
      "codigoEntidad": "movimiento_inventario",
      "prefijo": "MVI",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "sql": "SELECT id_material, nombre_material, stock_actual, stock_reservado, estado FROM aceros.material WHERE id_material = $1 FOR UPDATE",
      "values": [
        "MAT00000006",
      ],
    },
    "prisma": "$queryRaw",
  },
  {
    "args": {
      "data": {
        "stock_actual": Decimal(8.75),
      },
      "where": {
        "id_material": "MAT00000006",
      },
    },
    "prisma": "material.update",
  },
  {
    "args": {
      "data": {
        "cantidad": Decimal(3.75),
        "id_material": "MAT00000006",
        "id_movimiento": "MVI00000001",
        "id_orden_trabajo": "OTR00000007",
        "id_usuario_responsable": "USU00000001",
        "motivo": "Corte de prueba",
        "stock_anterior": Decimal(12.5),
        "stock_resultante": Decimal(8.75),
        "tipo_movimiento": "salida",
      },
    },
    "prisma": "movimiento_inventario.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Salida de inventario registrada para orden: OTR00000007",
      "enTransaccion": true,
      "entidad_afectada": "movimiento_inventario",
      "id_registro_afectado": "MVI00000001",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": {
      "data": {
        "id_registro_resultado": "MVI00000001",
      },
      "where": {
        "clave": "0b6f1d9e-3c4a-4f2b-9e7d-5a6b7c8d9e0f",
      },
    },
    "prisma": "operacion_idempotente.updateMany",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/inventory",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/inventory/materials",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/inventory/outputs",
    "effect": "revalidatePath",
  },
]
`;

