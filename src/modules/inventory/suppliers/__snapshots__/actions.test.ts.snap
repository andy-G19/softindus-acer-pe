exports[`createQuickSupplierAction > crea el proveedor con su correlativo y la bitacora dentro de la transaccion, sin redirigir > llamadas 1`] = `
[
  {
    "authz": "getAuthorizedSession",
    "roles": [
      "ADMIN",
    ],
  },
  {
    "args": {
      "select": {
        "estado": true,
      },
      "where": {
        "slug": "ferreteria",
      },
    },
    "prisma": "tipo_proveedor_catalogo.findUnique",
  },
  {
    "args": {
      "select": {
        "estado": true,
        "id_proveedor": true,
        "razon_social": true,
      },
      "where": {
        "razon_social": {
          "equals": "Ferreteria El Perno",
          "mode": "insensitive",
        },
      },
    },
    "prisma": "proveedor.findFirst",
  },
  {
    "args": null,
    "effect": "prisma.$transaction",
  },
  {
    "args": {
      "codigoEntidad": "proveedor",
      "prefijo": "PVE",
    },
    "effect": "getNextCorrelativeId",
  },
  {
    "args": {
      "data": {
        "estado": true,
        "id_proveedor": "PVE00000008",
        "observaciones": "Registrado desde el alta rápida de repuestos.",
        "razon_social": "Ferreteria El Perno",
        "telefono": "054 221 100",
        "tipo_proveedor": "ferreteria",
      },
    },
    "prisma": "proveedor.create",
  },
  {
    "args": {
      "accion": "crear",
      "detalle": "Proveedor creado (alta rápida): Ferreteria El Perno",
      "enTransaccion": true,
      "entidad_afectada": "proveedor",
      "id_registro_afectado": "PVE00000008",
      "userId": "USU00000001",
    },
    "effect": "registerAuditLog",
  },
  {
    "args": null,
    "effect": "prisma.$transaction:commit",
  },
  {
    "args": "/dashboard/inventory",
    "effect": "revalidatePath",
  },
  {
    "args": "/dashboard/inventory/suppliers",
    "effect": "revalidatePath",
  },
]
`;

exports[`createQuickSupplierAction > crea el proveedor con su correlativo y la bitacora dentro de la transaccion, sin redirigir > resultado 1`] = `
{
  "estado": {
    "ok": true,
    "supplier": {
      "id": "PVE00000008",
      "label": "Ferreteria El Perno",
    },
  },
}
`;

