# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development
.env.production
.env*.local

# allow example env file
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


/src/generated/prisma


# Instrucciones compartidas para agentes: se versionan CLAUDE.md, AGENTS.md
# y los comandos del equipo. La configuracion personal y las skills locales no.
/.claude/*
!/.claude/commands/
/.agents/
/.codex/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
/docs/*
!/docs/refactoring/
/output
/tmp/
/outputs
/.codex-finalizer/
