# Entorno de ejecucion. Next.js lo define automaticamente (development en
# `next dev`, production en `next build`/`next start`); normalmente no hace
# falta fijarlo a mano. Valores aceptados: development | test | production.
NODE_ENV="development"

# Base de datos PostgreSQL en Supabase
# En local/staging usamos normalmente Session Pooler puerto 5432.
# Obligatoria: la aplicacion no arranca sin ella (ver src/lib/env.ts).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=aceros"

# URL directa de Supabase. Se conserva para futuras migraciones o mantenimiento.
# Opcional: hoy no la usa el codigo de la app, solo se documenta aqui.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=aceros"

# Auth.js / NextAuth v5
# Obligatoria siempre. Generar con: npx auth secret
AUTH_SECRET="your-auth-secret"

# Local:
AUTH_URL="http://localhost:3000"

# En Vercel se configurará después como:
# AUTH_URL="https://tu-proyecto.vercel.app"
# AUTH_TRUST_HOST="true"

# Opcional. Permite que Auth.js confie en el host del request (util en
# plataformas como Vercel) en vez de depender solo de AUTH_URL.
# Valores aceptados: "true" | "1" (cualquier otro valor se trata como false).
# AUTH_TRUST_HOST="true"
