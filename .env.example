# Base de datos PostgreSQL en Supabase
# En local/staging usamos normalmente Session Pooler puerto 5432.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=aceros"

# URL directa de Supabase. Se conserva para futuras migraciones o mantenimiento.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=aceros"

# Auth.js / NextAuth v5
AUTH_SECRET="your-auth-secret"

# Local:
AUTH_URL="http://localhost:3000"

# En Vercel se configurará después como:
# AUTH_URL="https://tu-proyecto.vercel.app"
# AUTH_TRUST_HOST="true"